//! A real mainnet receipt proof, and the logs it commits to.
//!
//! Generated by `tools/mpt_to_fe.py` from `receipts_capella.json`. There is no RPC that
//! serves a receipt proof, so `tools/gen_receipt_fixture.mjs` rebuilt the
//! block's receipts trie from its 184 receipts and read a
//! proof out of it -- and that rebuild was accepted only because it hashes to
//! the `receiptsRoot` in the block header, exactly as the period rebuild must
//! hash to the `block_summary_root` the anchor state commits to.
//!
//! The builder is JavaScript and VeriFe's verifier is Fe, so these are two
//! independent implementations checked against data neither wrote.
//!
//! Provenance
//! ----------
//!   endpoint      https://eth-mainnet.g.alchemy.com/v2/l0YUGfesZoHlVVMulb3NI
//!   block         17,034,870
//!   block hash    0xe22c56f211f03baadcc91e4eb9a24344e6848c5df4473988f893b58223f5216c
//!   receipts root 0xe0ac34bafdd757bcca2dea27a3fc5870dd0836998877e29361c1fc55e19416ec
//!   receipts      184
//!   proved        transaction 1 (0x9537790ec5708ab44b55abb9d9939e80dfd947e4a396087addd8ff5c1f574226)

use core::ptr::MemBuffer

/// The block, and the receipts-trie root VeriFe proves as
/// `ExecutionPayload.receipts_root`.
pub const BLOCK_NUMBER: u64 = 17034870
pub const RECEIPTS_ROOT: u256 = 0xe0ac34bafdd757bcca2dea27a3fc5870dd0836998877e29361c1fc55e19416ec

/// The transaction whose receipt is proved, and its trie key.
///
/// The receipts trie keys by `rlp(index)` **unhashed**, so this key is
/// 1 byte(s) and not 32. That is why `mpt::lookup` takes a key
/// length.
pub const TX_INDEX: u64 = 1
pub const KEY_LEN: usize = 1
pub const RECEIPT_TYPE: u8 = 2
pub const RECEIPT_STATUS: u256 = 1
pub const CUMULATIVE_GAS_USED: u256 = 188135
pub const LOG_COUNT: usize = 6
/// `rlp(1)`, the trie key.
pub fn key() -> MemBuffer {
    let bytes: [u8; 1] = [0x01]
    var buf = MemBuffer::new(0)
    for byte in bytes {
        buf.push(byte)
    }
    buf
}
