//! The EVM verifier.
//!
//! This ingot contributes exactly two things on top of `verife`, and no proof
//! logic at all:
//!
//!   * the **anchor source** -- `verife::anchor::Eip4788`, a `STATICCALL` to
//!     the beacon-roots contract at
//!     `0x000F3df6D732807Ef1319fB7B8bB8522d0Beac02`; and
//!   * the **hasher** -- `verife::hash::PrecompileSha256`, the SHA-256
//!     precompile at address `0x02`.
//!
//! Every `recv` arm below is one call into `verife::prove`, which holds the
//! composed chain of commitments and is generic over both. The native CLI makes
//! the same calls with `FixedAnchor` and `SoftSha256`; `verife/src/prove.fe`
//! tests them with `FixedAnchor` and both hashers. That is the "one source, two
//! targets" claim, and it is also what makes the deployed path *tested* rather
//! than merely compiled: `fe test` has no beacon-roots contract and cannot call
//! from the system address, so the only way to run this code in a test is for
//! the anchor source to be a parameter.
//!
//! ## Why the entry points are named, not parameterised
//!
//! There is no `proveField(uint64 field, ...)`. Each payload field this
//! verifier can prove has its own entry point, so the field position is a
//! constant in this file rather than a number in calldata.
//! `payload_field_gindex` would bounds-check a caller's index against the
//! layout type anyway, but a field the contract never names is a field no
//! caller can ask for, and invariant 2 is easier to audit when there is nothing
//! to check.
//!
//! ## The anchor is a Fulu layout
//!
//! `ANCHOR` is fixed to `Fulu` at compile time, and `require_fork_version`
//! makes the chain agree: the anchor state's `fork.current_version` must equal
//! `Fulu`'s. On the next fork this contract stops verifying rather than
//! mis-verifying, and the replacement is a one-word change here plus a new
//! `ForkLayout` impl -- not a pivot slot, and not a redeployment with different
//! constants. That is the trade this project argues for: fail closed, and make
//! the fork a type.
//!
//! ## The cache, and what it does to invariant 1
//!
//! The historical path stores every `block_summary_root` it proves, and
//! `proveCached*` starts from a stored one instead of from an anchor. That is
//! the first state this project has ever kept, and it is deliberate: a period
//! commitment does not expire. `historical_summaries` only grows, the periods
//! already in it are finalized, and a `block_summary_root` is the hash tree
//! root of 8,192 finalized block roots. Proving one is a statement about
//! finalized history, and finalized history does not mean something new after
//! a fork.
//!
//! So a cached period stays answerable for ever: `proveCached*` takes no
//! anchor timestamp, no fork proof and no `ANCHOR` layout, makes no EIP-4788
//! call, and would go on working through Glamsterdam and past it without a
//! redeployment. The compiler is what guarantees the "no call" half -- those
//! arms do not declare `uses (call)`, so they cannot reach any address at all.
//!
//! The honest cost is that a stored root is a second thing a proof can start
//! from, so invariant 1 has to be restated rather than quietly stretched:
//!
//!   > The anchor root is the only trusted **input**. A stored summary root is
//!   > not an input: it is a value this contract proved from an anchor root in
//!   > an earlier transaction, admitted by one code path, write-once, and
//!   > never read from calldata.
//!
//! `verife::cache` holds that rule and the tests for it -- in the library, not
//! here, because nothing in a `recv` arm is reachable from `fe test`. In
//! short: only a complete historical proof can admit a value, an admitted
//! value can never become a different one, and zero means "nothing stored".
//!
//! What the cache cannot do is reach *forward*. A block mined after the next
//! fork needs that fork's payload layout, and nothing deployed today can know
//! it. `docs/forward-compat.md` sets out what would close that gap.
//!
//! The whole ingot is `#[cfg(target = "evm")]`: it calls a precompile and a
//! system contract, so there is nothing here to compile for a native target,
//! and `fe test --backend native` should not try.

#[cfg(target = "evm")]
use std::evm::effects::{Call, Ctx}
#[cfg(target = "evm")]
use std::evm::storage_map::StorageMap

#[cfg(target = "evm")]
use verife::anchor::{AnchorSource, Eip4788}
#[cfg(target = "evm")]
use verife::cache::{admit_summary_root, is_first_admission}
#[cfg(target = "evm")]
use verife::hash::PrecompileSha256
#[cfg(target = "evm")]
use verife::header::BeaconBlockHeader
#[cfg(target = "evm")]
use verife::layout::{
    Capella,
    ForkVersionProof,
    Fulu,
    HistoricalProof,
    PayloadProof,
    RecentProof,
    period_proof_len,
    summary_index,
    PAYLOAD_BLOCK_HASH_FIELD,
    PAYLOAD_BLOCK_NUMBER_FIELD,
    PAYLOAD_STATE_ROOT_FIELD,
}
#[cfg(target = "evm")]
use verife::prove::{
    prove_cached_payload_root,
    prove_cached_payload_uint64,
    prove_historical_payload_root,
    prove_historical_target,
    prove_recent_payload_root,
    prove_recent_payload_uint64,
}

/// A `BeaconBlockHeader` as it arrives in calldata: the five SSZ fields, in
/// order, as a tuple.
///
/// Fe checks a `msg` selector against the ABI types of its fields, so the
/// `(uint64,uint64,uint256,uint256,uint256)` written in each selector below
/// cannot drift from this shape without a compile error. Getting a selector
/// wrong is the ordinary way an ABI breaks, and here it does not build.
#[cfg(target = "evm")]
type HeaderAbi = (u64, u64, u256, u256, u256)

/// The anchor's fork layout. See the module note.
#[cfg(target = "evm")]
type ANCHOR = Fulu

#[cfg(target = "evm")]
msg VerifeMsg {
    /// `ExecutionPayload.block_hash` of a block within the anchor's ~27-hour
    /// window.
    #[selector = sol(
        "proveRecentBlockHash(uint64,(uint64,uint64,uint256,uint256,uint256),uint256[8],uint64,(uint64,uint64,uint256,uint256,uint256),uint256[19],uint256[9],uint256)",
    )]
    ProveRecentBlockHash {
        anchor_timestamp: u64,
        anchor_header: HeaderAbi,
        fork_branch: [u256; 8],
        target_slot: u64,
        target_header: HeaderAbi,
        recent_branch: [u256; 19],
        payload_branch: [u256; 9],
        block_hash: u256,
    } -> u256,

    /// `ExecutionPayload.state_root` of a recent block: the execution state
    /// root, which is what an EIP-1186 account or storage proof hangs from.
    #[selector = sol(
        "proveRecentStateRoot(uint64,(uint64,uint64,uint256,uint256,uint256),uint256[8],uint64,(uint64,uint64,uint256,uint256,uint256),uint256[19],uint256[9],uint256)",
    )]
    ProveRecentStateRoot {
        anchor_timestamp: u64,
        anchor_header: HeaderAbi,
        fork_branch: [u256; 8],
        target_slot: u64,
        target_header: HeaderAbi,
        recent_branch: [u256; 19],
        payload_branch: [u256; 9],
        state_root: u256,
    } -> u256,

    /// `ExecutionPayload.block_number` of a recent block. A `uint64` SSZ leaf,
    /// so this one goes through the little-endian decoder (invariant 11).
    #[selector = sol(
        "proveRecentBlockNumber(uint64,(uint64,uint64,uint256,uint256,uint256),uint256[8],uint64,(uint64,uint64,uint256,uint256,uint256),uint256[19],uint256[9],uint64)",
    )]
    ProveRecentBlockNumber {
        anchor_timestamp: u64,
        anchor_header: HeaderAbi,
        fork_branch: [u256; 8],
        target_slot: u64,
        target_header: HeaderAbi,
        recent_branch: [u256; 19],
        payload_branch: [u256; 9],
        block_number: u64,
    } -> u64,

    /// `ExecutionPayload.block_hash` of a **Capella** block, reached through
    /// `historical_summaries` -- any block from Capella's first slot onward,
    /// not just the last 27 hours.
    ///
    /// The payload branch is 8 levels here rather than 9, because Capella's
    /// `ExecutionPayload` has 15 fields and later forks have 17. Nothing in
    /// this file says 8: the length comes from `PayloadProof<Capella>`, so the
    /// ABI type below is the one the layout implies, and a Deneb-shaped branch
    /// does not type.
    #[selector = sol(
        "proveHistoricalCapellaBlockHash(uint64,(uint64,uint64,uint256,uint256,uint256),uint256[8],uint64,(uint64,uint64,uint256,uint256,uint256),uint64,uint64,uint256[32],uint256[7],uint256[13],uint256[8],uint256)",
    )]
    ProveHistoricalCapellaBlockHash {
        anchor_timestamp: u64,
        anchor_header: HeaderAbi,
        fork_branch: [u256; 8],
        target_slot: u64,
        target_header: HeaderAbi,
        summary_index: u64,
        summary_count: u64,
        summary_branch: [u256; 32],
        length_branch: [u256; 7],
        period_branch: [u256; 13],
        payload_branch: [u256; 8],
        block_hash: u256,
    } -> u256,

    /// `ExecutionPayload.block_hash` of a **Capella** block, from a period
    /// summary root this contract has already proven and stored.
    ///
    /// No anchor timestamp, no fork proof, no EIP-4788 call: see the module
    /// note on the cache. The period is derived from `target_slot`, so no
    /// index arrives in calldata.
    #[selector = sol(
        "proveCachedCapellaBlockHash(uint64,(uint64,uint64,uint256,uint256,uint256),uint256[13],uint256[8],uint256)",
    )]
    ProveCachedCapellaBlockHash {
        target_slot: u64,
        target_header: HeaderAbi,
        period_branch: [u256; period_proof_len()],
        payload_branch: [u256; 8],
        block_hash: u256,
    } -> u256,

    /// `ExecutionPayload.block_number` of a Capella block, from a stored
    /// period summary root. A `uint64` leaf, so this goes through the
    /// little-endian decoder (invariant 11).
    #[selector = sol(
        "proveCachedCapellaBlockNumber(uint64,(uint64,uint64,uint256,uint256,uint256),uint256[13],uint256[8],uint64)",
    )]
    ProveCachedCapellaBlockNumber {
        target_slot: u64,
        target_header: HeaderAbi,
        period_branch: [u256; period_proof_len()],
        payload_branch: [u256; 8],
        block_number: u64,
    } -> u64,

    /// The stored `block_summary_root` for the period that holds `target_slot`,
    /// or zero if this contract has never proven it.
    ///
    /// Zero means "ask by the historical path first, while an anchor of a fork
    /// this code knows is still live". It never means "cached as zero": the
    /// cached path refuses a zero root.
    #[selector = sol("cachedSummaryRootForSlot(uint64)")]
    CachedSummaryRootForSlot { target_slot: u64 } -> u256,

    /// The beacon block root EIP-4788 holds for an execution timestamp.
    ///
    /// Not part of a proof: it is here so a caller can see the one trusted
    /// input for themselves, and so a proof generator can confirm it is
    /// building against the root this contract will read.
    #[selector = sol("anchorRootAt(uint64)")]
    AnchorRootAt { timestamp: u64 } -> u256,
}

#[cfg(target = "evm")]
#[event]
struct PayloadFieldProven {
    #[indexed]
    target_slot: u64,
    /// The SSZ field position within `ExecutionPayload`.
    field: u64,
    value: u256,
}

/// A period's `block_summary_root` was proven out of an anchor state and
/// stored. From here on, every block in that period is provable without an
/// anchor.
#[cfg(target = "evm")]
#[event]
struct PeriodSummaryCached {
    #[indexed]
    summary_index: u64,
    summary_root: u256,
}

#[cfg(target = "evm")]
pub contract Verife uses (ctx: Ctx, call: Call, log: mut Log) {
    /// `historical_summaries[i].block_summary_root`, for every period `i` this
    /// contract has proven out of an anchor state.
    ///
    /// Written only from a `verify_historical` result -- never from calldata --
    /// and write-once: `verife::cache::admit_summary_root` is the only thing
    /// that decides what goes in, and it refuses to replace an entry with a
    /// different value. See that module for what this does to invariant 1.
    mut period_summary_root: StorageMap<u64, u256>,

    recv VerifeMsg {
        ProveRecentBlockHash {
            anchor_timestamp,
            anchor_header,
            fork_branch,
            target_slot,
            target_header,
            recent_branch,
            payload_branch,
            block_hash,
        } -> u256
        uses (call, mut log)
        {
            let value = prove_recent_payload_root<ANCHOR, Fulu, _, _>(
                source: Eip4788 {},
                hasher: PrecompileSha256 {},
                anchor_timestamp,
                anchor_header: header_from_abi(anchor_header),
                fork_proof: ForkVersionProof<ANCHOR> { branch: fork_branch },
                target_slot,
                target_header: header_from_abi(target_header),
                proof: RecentProof<ANCHOR> { branch: recent_branch },
                field: PAYLOAD_BLOCK_HASH_FIELD,
                value: block_hash,
                payload_proof: PayloadProof<Fulu> { branch: payload_branch },
            )
            log.emit(
                PayloadFieldProven { target_slot, field: PAYLOAD_BLOCK_HASH_FIELD, value },
            )
            value
        }

        ProveRecentStateRoot {
            anchor_timestamp,
            anchor_header,
            fork_branch,
            target_slot,
            target_header,
            recent_branch,
            payload_branch,
            state_root,
        } -> u256
        uses (call, mut log)
        {
            let value = prove_recent_payload_root<ANCHOR, Fulu, _, _>(
                source: Eip4788 {},
                hasher: PrecompileSha256 {},
                anchor_timestamp,
                anchor_header: header_from_abi(anchor_header),
                fork_proof: ForkVersionProof<ANCHOR> { branch: fork_branch },
                target_slot,
                target_header: header_from_abi(target_header),
                proof: RecentProof<ANCHOR> { branch: recent_branch },
                field: PAYLOAD_STATE_ROOT_FIELD,
                value: state_root,
                payload_proof: PayloadProof<Fulu> { branch: payload_branch },
            )
            log.emit(
                PayloadFieldProven { target_slot, field: PAYLOAD_STATE_ROOT_FIELD, value },
            )
            value
        }

        ProveRecentBlockNumber {
            anchor_timestamp,
            anchor_header,
            fork_branch,
            target_slot,
            target_header,
            recent_branch,
            payload_branch,
            block_number,
        } -> u64
        uses (call, mut log)
        {
            let value = prove_recent_payload_uint64<ANCHOR, Fulu, _, _>(
                source: Eip4788 {},
                hasher: PrecompileSha256 {},
                anchor_timestamp,
                anchor_header: header_from_abi(anchor_header),
                fork_proof: ForkVersionProof<ANCHOR> { branch: fork_branch },
                target_slot,
                target_header: header_from_abi(target_header),
                proof: RecentProof<ANCHOR> { branch: recent_branch },
                field: PAYLOAD_BLOCK_NUMBER_FIELD,
                value: block_number,
                payload_proof: PayloadProof<Fulu> { branch: payload_branch },
            )
            log.emit(
                PayloadFieldProven {
                    target_slot,
                    field: PAYLOAD_BLOCK_NUMBER_FIELD,
                    value: value as u256,
                },
            )
            value
        }

        ProveHistoricalCapellaBlockHash {
            anchor_timestamp,
            anchor_header,
            fork_branch,
            target_slot,
            target_header,
            summary_index,
            summary_count,
            summary_branch,
            length_branch,
            period_branch,
            payload_branch,
            block_hash,
        } -> u256
        uses (call, mut log, mut period_summary_root)
        {
            // The anchor's layout is Fulu and the target's is Capella: the
            // state-side branches are Fulu's, the payload branch is Capella's.
            // They are separate type parameters for exactly this reason.
            let proven = prove_historical_payload_root<ANCHOR, Capella, _, _>(
                source: Eip4788 {},
                hasher: PrecompileSha256 {},
                anchor_timestamp,
                anchor_header: header_from_abi(anchor_header),
                fork_proof: ForkVersionProof<ANCHOR> { branch: fork_branch },
                target_slot,
                target_header: header_from_abi(target_header),
                proof: HistoricalProof<ANCHOR> {
                    index: summary_index,
                    length: summary_count,
                    summary_branch,
                    length_branch,
                    period_branch,
                },
                field: PAYLOAD_BLOCK_HASH_FIELD,
                value: block_hash,
                payload_proof: PayloadProof<Capella> { branch: payload_branch },
            )

            // Keep what was proven. From here on every block in this period is
            // provable without an anchor, and so through a fork this contract
            // has never heard of. The write-once rule lives in `verife::cache`
            // so that it can be tested; this arm only applies it.
            let stored = period_summary_root[proven.summary_index]
            let admitted = admit_summary_root(stored, proven: proven.summary_root)
            if is_first_admission(stored) {
                period_summary_root[proven.summary_index] = admitted
                log.emit(
                    PeriodSummaryCached {
                        summary_index: proven.summary_index,
                        summary_root: admitted,
                    },
                )
            }

            log.emit(
                PayloadFieldProven {
                    target_slot,
                    field: PAYLOAD_BLOCK_HASH_FIELD,
                    value: proven.value,
                },
            )
            proven.value
        }

        ProveCachedCapellaBlockHash {
            target_slot,
            target_header,
            period_branch,
            payload_branch,
            block_hash,
        } -> u256
        uses (period_summary_root, mut log)
        {
            // Note the effect row: `call` is absent. This arm cannot reach
            // EIP-4788 or any other address, and that is checked by the
            // compiler rather than claimed in a comment -- which is the whole
            // argument for the cached path. Note also what is absent from the
            // call itself: no `ANCHOR`, no fork proof, nothing that names the
            // fork that happens to be live.
            let value = prove_cached_payload_root<Capella, _>(
                hasher: PrecompileSha256 {},
                summary_root: period_summary_root[summary_index(slot: target_slot)],
                target_slot,
                target_header: header_from_abi(target_header),
                period_branch,
                field: PAYLOAD_BLOCK_HASH_FIELD,
                value: block_hash,
                payload_proof: PayloadProof<Capella> { branch: payload_branch },
            )
            log.emit(
                PayloadFieldProven { target_slot, field: PAYLOAD_BLOCK_HASH_FIELD, value },
            )
            value
        }

        ProveCachedCapellaBlockNumber {
            target_slot,
            target_header,
            period_branch,
            payload_branch,
            block_number,
        } -> u64
        uses (period_summary_root, mut log)
        {
            let value = prove_cached_payload_uint64<Capella, _>(
                hasher: PrecompileSha256 {},
                summary_root: period_summary_root[summary_index(slot: target_slot)],
                target_slot,
                target_header: header_from_abi(target_header),
                period_branch,
                field: PAYLOAD_BLOCK_NUMBER_FIELD,
                value: block_number,
                payload_proof: PayloadProof<Capella> { branch: payload_branch },
            )
            log.emit(
                PayloadFieldProven {
                    target_slot,
                    field: PAYLOAD_BLOCK_NUMBER_FIELD,
                    value: value as u256,
                },
            )
            value
        }

        CachedSummaryRootForSlot { target_slot } -> u256
        uses (period_summary_root)
        {
            period_summary_root[summary_index(slot: target_slot)]
        }

        AnchorRootAt { timestamp } -> u256 uses (call) {
            let source = Eip4788 {}
            source.root_at(timestamp)
        }
    }
}

/// The calldata tuple as a `BeaconBlockHeader`.
///
/// A header is not trusted for arriving here: both headers are hashed and
/// required to equal a root that was already proven (steps 2 and 5).
#[cfg(target = "evm")]
fn header_from_abi(_ h: HeaderAbi) -> BeaconBlockHeader {
    BeaconBlockHeader {
        slot: h.0,
        proposer_index: h.1,
        parent_root: h.2,
        state_root: h.3,
        body_root: h.4,
    }
}
