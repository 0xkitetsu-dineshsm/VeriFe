//! The two halves, joined: one beacon block root to a contract's storage slot.
//!
//! Everything else in this library is one half or the other. The SSZ modules
//! take an EIP-4788 beacon block root down to a field of a block's
//! `ExecutionPayload`; `rlp` and `mpt` take an execution-layer root down to an
//! account, a slot or a log. This module is the single test that runs them as
//! one chain, and it exists because two halves that each pass their own tests
//! can still fail to meet.
//!
//! What makes it a join rather than two tests side by side: **every root after
//! the first is the return value of the previous proof.** The MPT lookup is
//! handed the `state_root` that `prove_recent_payload_root` returned, and the
//! storage lookup is handed the `storageRoot` that the account lookup
//! decoded. Nothing downstream reads a constant. If the two halves disagreed
//! about what a `state_root` is, this would not compile past the first
//! assertion.
//!
//! The chain, in full:
//!
//! ```text
//!   EIP-4788 root for timestamp t          ← the only trusted input
//!     → BeaconBlockHeader (5 fields, SHA-256)
//!       → BeaconState.block_roots[slot mod 8192]
//!         → target BeaconBlockHeader
//!           → BeaconBlockBody.execution_payload.state_root     ── SSZ ends
//!             → state trie: keccak256(address) → account RLP   ── MPT begins
//!               → account.storageRoot
//!                 → storage trie: keccak256(slot) → the value
//! ```
//!
//! Nine levels of commitment, two hash functions, two encodings, and one
//! trusted input at the top.
//!
//! ## Why this fixture is a different one
//!
//! The older fixtures share an anchor from 2026-11-21 whose EIP-4788 window
//! has long closed, and `eth_getProof` is not served for a block that old by
//! any keyless endpoint. So the join needed a *fresh* anchor: a `recent`
//! fixture needs no 8,192-root period rebuild, so it costs a state download
//! and a few API calls, and its target block is minutes rather than days old
//! -- inside the window where a node will still answer `eth_getProof`.
//!
//! `fixtures/recent_join.json` and `fixtures/mpt/join_mainnet.json` are that
//! pair, and the first thing asserted below is that they are about the same
//! block.

use core::ptr::MemBuffer
use ingot::anchor::FixedAnchor
#[cfg(target = "native")]
use ingot::fixture_join_mainnet as exec
#[cfg(target = "native")]
use ingot::fixture_recent_join as beacon
use ingot::hash::{SoftKeccak, SoftSha256}
use ingot::layout::{Fulu, PAYLOAD_STATE_ROOT_FIELD}
use ingot::mpt
use ingot::prove::prove_recent_payload_root
use ingot::rlp

/// A `u256` as the 32 big-endian bytes a trie key is.
#[cfg(target = "native")]
fn key_of(_ value: u256) -> MemBuffer {
    var buf = MemBuffer::new(0)
    var byte: u8 = 32
    while byte > 0 {
        byte -= 1
        buf.push(((value >> (byte as u256 * 8)) & 0xff).downcast_truncate())
    }
    buf
}

#[cfg(target = "native")]
#[test]
fn one_beacon_root_proves_a_contract_s_storage_slot() {
    let sha = SoftSha256 {}
    let keccak = SoftKeccak {}

    // The two fixtures must describe the same block, or the join below would
    // be proving a root from one block and reading a trie from another.
    assert!(
        beacon::PAYLOAD_BLOCK_NUMBER == exec::BLOCK_NUMBER,
        "the beacon fixture and the proof fixture are for different blocks",
    )

    // --- The SSZ half -------------------------------------------------------
    //
    // From the one trusted input to the execution state root. `FixedAnchor`
    // stands in for the EIP-4788 call, which `tools/fork_check.sh` checks
    // separately against the real contract; the fixture records that the live
    // contract returned this root for this timestamp.
    let state_root = prove_recent_payload_root<Fulu, Fulu, _, _>(
        source: FixedAnchor { timestamp: beacon::ANCHOR_TIMESTAMP, root: beacon::ANCHOR_ROOT },
        hasher: sha,
        anchor_timestamp: beacon::ANCHOR_TIMESTAMP,
        anchor_header: beacon::anchor_header(),
        fork_proof: beacon::fork_version_proof(),
        target_slot: beacon::TARGET_SLOT,
        target_header: beacon::target_header(),
        proof: beacon::recent_proof(),
        field: PAYLOAD_STATE_ROOT_FIELD,
        value: beacon::PAYLOAD_STATE_ROOT,
        payload_proof: beacon::state_root_proof(),
    )

    // --- The handover -------------------------------------------------------
    //
    // `state_root` is now a *proven* value, not a constant. Everything below
    // hangs from it.
    assert!(
        state_root == exec::STATE_ROOT,
        "the halves disagree about the block's state root",
    )

    // --- The MPT half: the account ------------------------------------------
    var account_proof = exec::account_proof()
    let account_buf = account_proof.span()
    var account_key = key_of(exec::ACCOUNT_KEY)
    let account_found = mpt::lookup(
        hasher: keccak,
        account_buf,
        proof: rlp::read_item(account_buf, at: 0),
        root: state_root,
        key: account_key.span(),
        key_offset: 0,
        key_len: 32,
    )
    assert!(
        account_found.present,
        "the account is in the proven state trie",
    )

    let account = rlp::read_item(account_buf, at: account_found.value_at)
    assert!(rlp::count(account_buf, list: account) == 4)
    let storage_root = rlp::read_hash(
        account_buf,
        item: rlp::nth(account_buf, list: account, index: 2),
    )

    // --- The MPT half: the slot ---------------------------------------------
    //
    // `storage_root` came out of the account that came out of the state root
    // that came out of the beacon root. Three proofs deep, no constants.
    var slot_proof = exec::slot_0_proof()
    let slot_buf = slot_proof.span()
    var slot_key = key_of(exec::SLOT_0_KEY)
    let slot_found = mpt::lookup(
        hasher: keccak,
        slot_buf,
        proof: rlp::read_item(slot_buf, at: 0),
        root: storage_root,
        key: slot_key.span(),
        key_offset: 0,
        key_len: 32,
    )
    assert!(slot_found.present, "slot 0 is set")
    let value = rlp::read_uint(
        slot_buf,
        item: rlp::read_item(slot_buf, at: slot_found.value_at),
    )

    // And that is the answer: USDC's slot 0 at this block, proven from one
    // beacon block root.
    assert!(value == exec::SLOT_0_VALUE)
}

#[cfg(target = "native")]
#[test]
fn the_same_chain_proves_a_slot_is_empty() {
    // Absence, end to end. A verifier that can only prove presence cannot
    // answer "this account holds nothing", which is the question a
    // cross-chain reader asks most often.
    let sha = SoftSha256 {}
    let keccak = SoftKeccak {}

    let state_root = prove_recent_payload_root<Fulu, Fulu, _, _>(
        source: FixedAnchor { timestamp: beacon::ANCHOR_TIMESTAMP, root: beacon::ANCHOR_ROOT },
        hasher: sha,
        anchor_timestamp: beacon::ANCHOR_TIMESTAMP,
        anchor_header: beacon::anchor_header(),
        fork_proof: beacon::fork_version_proof(),
        target_slot: beacon::TARGET_SLOT,
        target_header: beacon::target_header(),
        proof: beacon::recent_proof(),
        field: PAYLOAD_STATE_ROOT_FIELD,
        value: beacon::PAYLOAD_STATE_ROOT,
        payload_proof: beacon::state_root_proof(),
    )

    var account_proof = exec::account_proof()
    let account_buf = account_proof.span()
    var account_key = key_of(exec::ACCOUNT_KEY)
    let account_found = mpt::lookup(
        hasher: keccak,
        account_buf,
        proof: rlp::read_item(account_buf, at: 0),
        root: state_root,
        key: account_key.span(),
        key_offset: 0,
        key_len: 32,
    )
    let account = rlp::read_item(account_buf, at: account_found.value_at)
    let storage_root = rlp::read_hash(
        account_buf,
        item: rlp::nth(account_buf, list: account, index: 2),
    )

    var slot_proof = exec::slot_1_proof()
    let slot_buf = slot_proof.span()
    var slot_key = key_of(exec::SLOT_1_KEY)
    let slot_found = mpt::lookup(
        hasher: keccak,
        slot_buf,
        proof: rlp::read_item(slot_buf, at: 0),
        root: storage_root,
        key: slot_key.span(),
        key_offset: 0,
        key_len: 32,
    )
    assert!(!slot_found.present, "the slot is provably empty")
    assert!(exec::SLOT_1_VALUE == 0)
}

#[cfg(target = "native")]
#[test(should_revert)]
fn a_storage_proof_against_an_unproven_state_root_is_refused() {
    // The join's own failure mode. The MPT half is handed a state root that
    // no beacon proof produced -- one bit off the proven one -- and the first
    // node no longer hashes to it.
    let keccak = SoftKeccak {}
    var account_proof = exec::account_proof()
    let account_buf = account_proof.span()
    var account_key = key_of(exec::ACCOUNT_KEY)
    let _ = mpt::lookup(
        hasher: keccak,
        account_buf,
        proof: rlp::read_item(account_buf, at: 0),
        root: exec::STATE_ROOT ^ 1,
        key: account_key.span(),
        key_offset: 0,
        key_len: 32,
    )
}

// --- The same chain, 3.6 years and four forks deep ---------------------------

#[cfg(target = "native")]
use ingot::fixture_hist_join_mainnet as old_exec
use ingot::fixture_historical_capella as old_beacon
use ingot::layout::Capella
use ingot::prove::prove_historical_payload_root

#[cfg(target = "native")]
#[test]
fn one_beacon_root_proves_an_erc20_balance_from_april_2023() {
    // The same chain as the test below, aimed at the slot a real consumer
    // actually cares about: **an ERC-20 balance held in a mapping**.
    //
    // Slot 0 of a proxy is an opaque address. This is
    // `keccak256(abi.encode(holder, 9))` -- USDC keeps balances in the mapping
    // at slot 9 -- so it is the eligibility question an airdrop, a snapshot or
    // a dispute would ask: *how much did this address hold at that block?*
    //
    // The answer is cross-checked against a route that shares nothing with it.
    // `eth_call balanceOf(holder)` at block 17,034,870 runs the contract's
    // code and never touches the trie; this proof walks the trie and never
    // runs the code. Both say 152,808,678.923352 USDC.
    let sha = SoftSha256 {}
    let keccak = SoftKeccak {}

    let proven = prove_historical_payload_root<Fulu, Capella, _, _>(
        source: FixedAnchor {
            timestamp: ingot::fixture_recent_fulu::ANCHOR_TIMESTAMP,
            root: old_beacon::ANCHOR_ROOT,
        },
        hasher: sha,
        anchor_timestamp: ingot::fixture_recent_fulu::ANCHOR_TIMESTAMP,
        anchor_header: old_beacon::anchor_header(),
        fork_proof: old_beacon_fork_proof(),
        target_slot: old_beacon::TARGET_SLOT,
        target_header: old_beacon::target_header(),
        proof: old_beacon::historical_proof(),
        field: PAYLOAD_STATE_ROOT_FIELD,
        value: old_beacon::PAYLOAD_STATE_ROOT,
        payload_proof: old_beacon::state_root_proof(),
    )

    // The account, out of the proven state root.
    var account_proof = old_exec::account_proof()
    let account_buf = account_proof.span()
    var account_key = key_of(old_exec::ACCOUNT_KEY)
    let account = mpt::lookup(
        hasher: keccak,
        account_buf,
        proof: rlp::read_item(account_buf, at: 0),
        root: proven.value,
        key: account_key.span(),
        key_offset: 0,
        key_len: 32,
    )
    assert!(account.present, "USDC's account at the proven state root")
    let fields = rlp::read_item(account_buf, at: account.value_at)
    let storage_root = rlp::read_hash(
        account_buf,
        item: rlp::nth(account_buf, list: fields, index: 2),
    )

    // The mapping slot, out of the storage root the account carried.
    var slot_proof = old_exec::slot_1_proof()
    let slot_buf = slot_proof.span()
    // The trie key is keccak256 of the slot, not the slot itself.
    var slot_key = key_of(old_exec::SLOT_1_KEY)
    let found = mpt::lookup(
        hasher: keccak,
        slot_buf,
        proof: rlp::read_item(slot_buf, at: 0),
        root: storage_root,
        key: slot_key.span(),
        key_offset: 0,
        key_len: 32,
    )
    assert!(found.present, "the holder has a balance at that block")
    assert!(
        old_exec::SLOT_1 == old_exec::HOLDER_SLOT,
        "the proven slot is the one keccak256(holder, 9) derives",
    )

    let balance = rlp::read_uint(
        slot_buf,
        item: rlp::read_item(slot_buf, at: found.value_at),
    )
    assert!(
        balance == old_exec::HOLDER_BALANCE,
        "the proven balance is what eth_call balanceOf reported",
    )
    // 152,808,678.923352 USDC, to six decimals.
    assert!(balance == 152808678923352)
}

#[cfg(target = "native")]
#[test]
fn one_beacon_root_proves_a_storage_slot_from_april_2023() {
    // This is the claim the whole project exists to support.
    //
    // The anchor is a Fulu beacon block root from November 2026. The target is
    // **the first Capella block**, slot 6,209,538, execution block 17,034,870,
    // 13 April 2023 -- four forks and about 3.6 years earlier, far outside the
    // 27-hour EIP-4788 window and far outside the 256-block `BLOCKHASH`
    // window that an execution-layer-only design is limited to.
    //
    // The route runs through `BeaconState.historical_summaries`, and then
    // straight on into the execution layer's own trie:
    //
    //   EIP-4788 root (Nov 2026)
    //     -> anchor BeaconBlockHeader
    //       -> historical_summaries[0].block_summary_root   (field 0, invariant 3)
    //         -> that period's Vector[Root, 8192], index 2
    //           -> target BeaconBlockHeader (Apr 2023)
    //             -> body.execution_payload.state_root       -- SSZ ends
    //               -> state trie: keccak256(USDC) -> account
    //                 -> account.storageRoot
    //                   -> storage trie: keccak256(slot 0) -> the value
    //
    // Every root below the first is the previous proof's return value.
    let sha = SoftSha256 {}
    let keccak = SoftKeccak {}

    assert!(
        old_beacon::PAYLOAD_BLOCK_NUMBER == old_exec::BLOCK_NUMBER,
        "the two fixtures are for different blocks",
    )

    // The historical path. `A = Fulu` for every state-side branch and
    // `T = Capella` for the payload: Capella's payload has 15 fields where
    // Fulu's has 17, so the payload branch is 8 levels rather than 9 -- a
    // length the compiler derives, and passing the wrong one does not compile.
    let proven = prove_historical_payload_root<Fulu, Capella, _, _>(
        source: FixedAnchor {
            timestamp: ingot::fixture_recent_fulu::ANCHOR_TIMESTAMP,
            root: old_beacon::ANCHOR_ROOT,
        },
        hasher: sha,
        anchor_timestamp: ingot::fixture_recent_fulu::ANCHOR_TIMESTAMP,
        anchor_header: old_beacon::anchor_header(),
        fork_proof: old_beacon_fork_proof(),
        target_slot: old_beacon::TARGET_SLOT,
        target_header: old_beacon::target_header(),
        proof: old_beacon::historical_proof(),
        field: PAYLOAD_STATE_ROOT_FIELD,
        value: old_beacon::PAYLOAD_STATE_ROOT,
        payload_proof: old_beacon::state_root_proof(),
    )
    let state_root = proven.value
    assert!(
        state_root == old_exec::STATE_ROOT,
        "the halves disagree about the state root",
    )

    // The account, out of a state root nobody supplied.
    var account_proof = old_exec::account_proof()
    let account_buf = account_proof.span()
    var account_key = key_of(old_exec::ACCOUNT_KEY)
    let account_found = mpt::lookup(
        hasher: keccak,
        account_buf,
        proof: rlp::read_item(account_buf, at: 0),
        root: state_root,
        key: account_key.span(),
        key_offset: 0,
        key_len: 32,
    )
    assert!(account_found.present, "the account existed at that block")
    let account = rlp::read_item(account_buf, at: account_found.value_at)
    let storage_root = rlp::read_hash(
        account_buf,
        item: rlp::nth(account_buf, list: account, index: 2),
    )
    assert!(storage_root == old_exec::ACCOUNT_STORAGE_ROOT)

    // And the slot.
    var slot_proof = old_exec::slot_0_proof()
    let slot_buf = slot_proof.span()
    var slot_key = key_of(old_exec::SLOT_0_KEY)
    let slot_found = mpt::lookup(
        hasher: keccak,
        slot_buf,
        proof: rlp::read_item(slot_buf, at: 0),
        root: storage_root,
        key: slot_key.span(),
        key_offset: 0,
        key_len: 32,
    )
    assert!(slot_found.present)
    let value = rlp::read_uint(
        slot_buf,
        item: rlp::read_item(slot_buf, at: slot_found.value_at),
    )
    assert!(value == old_exec::SLOT_0_VALUE)
}

#[cfg(target = "native")]
#[test]
fn a_slot_was_already_empty_in_april_2023() {
    // Absence, 3.6 years back. The proof is five nodes here against seven at
    // the recent block, because the trie was smaller then -- which is a
    // reminder that an absence proof is a statement about the trie's shape at
    // that block and not a general fact.
    let keccak = SoftKeccak {}
    var slot_proof = old_exec::slot_2_proof()
    let slot_buf = slot_proof.span()
    var slot_key = key_of(old_exec::SLOT_2_KEY)
    let slot_found = mpt::lookup(
        hasher: keccak,
        slot_buf,
        proof: rlp::read_item(slot_buf, at: 0),
        root: old_exec::ACCOUNT_STORAGE_ROOT,
        key: slot_key.span(),
        key_offset: 0,
        key_len: 32,
    )
    assert!(
        !slot_found.present,
        "the slot was unset at that block too",
    )
    assert!(!old_exec::SLOT_2_PRESENT)
}

/// The historical fixture emits no fork-version proof of its own: it shares
/// its anchor state with `recent_fulu`, which does. `prove.fe`'s
/// `every_fixture_shares_one_anchor` is what keeps that from being an
/// assumption.
#[cfg(target = "native")]
fn old_beacon_fork_proof() -> ingot::layout::ForkVersionProof<Fulu> {
    ingot::fixture_recent_fulu::fork_version_proof()
}
