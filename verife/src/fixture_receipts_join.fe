//! A real mainnet receipt proof, and the logs it commits to.
//!
//! Generated by `tools/mpt_to_fe.py` from `receipts_join.json`. There is no RPC that
//! serves a receipt proof, so `tools/gen_receipt_fixture.mjs` rebuilt the
//! block's receipts trie from its 186 receipts and read a
//! proof out of it -- and that rebuild was accepted only because it hashes to
//! the `receiptsRoot` in the block header, exactly as the period rebuild must
//! hash to the `block_summary_root` the anchor state commits to.
//!
//! The builder is JavaScript and VeriFe's verifier is Fe, so these are two
//! independent implementations checked against data neither wrote.
//!
//! Provenance
//! ----------
//!   endpoint      https://ethereum-rpc.publicnode.com
//!   block         26,472,715
//!   block hash    0x4ea72726d1d7ad4ac41b5686b13d55e35b520d50744c26367889f4b1bccb30eb
//!   receipts root 0x7089b55a6ac2fdc159eed2fca40232a0acaadd39ba10fb3810abe09c93e72a0a
//!   receipts      186
//!   proved        transaction 0 (0xa7f1a04d6a85f44797cda6f186edf5c6138b9c987b52857d8ed400bf125d8945)

use core::ptr::MemBuffer

/// The block, and the receipts-trie root VeriFe proves as
/// `ExecutionPayload.receipts_root`.
#[cfg(target = "native")]
pub const BLOCK_NUMBER: u64 = 26472715
#[cfg(target = "native")]
pub const RECEIPTS_ROOT: u256 = 0x7089b55a6ac2fdc159eed2fca40232a0acaadd39ba10fb3810abe09c93e72a0a

/// The transaction whose receipt is proved, and its trie key.
///
/// The receipts trie keys by `rlp(index)` **unhashed**, so this key is
/// 1 byte(s) and not 32. That is why `mpt::lookup` takes a key
/// length.
#[cfg(target = "native")]
pub const TX_INDEX: u64 = 0
#[cfg(target = "native")]
pub const KEY_LEN: usize = 1
#[cfg(target = "native")]
pub const RECEIPT_TYPE: u8 = 2
#[cfg(target = "native")]
pub const RECEIPT_STATUS: u256 = 1
#[cfg(target = "native")]
pub const CUMULATIVE_GAS_USED: u256 = 248608
#[cfg(target = "native")]
pub const LOG_COUNT: usize = 9
/// `rlp(0)`, the trie key.
#[cfg(target = "native")]
pub fn key() -> MemBuffer {
    let bytes: [u8; 1] = [0x80]
    var buf = MemBuffer::new(0)
    for byte in bytes {
        buf.push(byte)
    }
    buf
}
