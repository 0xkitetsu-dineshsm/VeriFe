// --- The generator's positions, against the verifier's -----------------------
//
// Left of each `==`: what `@lodestar/types` computed, carried in the fixture.
// Right: what this library derives from the layout type with `const fn`.
//
// Two independent derivations of the same number, compared at COMPILE TIME.
// A disagreement stops the build rather than failing a test, and neither side
// can drift toward the other because they share no code: lodestar hand-writes
// the consensus containers in TypeScript, this library computes positions from
// field counts.
//
// The intermediate `DERIVED_*` consts exist so each `static_assert` fits on one
// line. `fe fmt` wraps a longer one and adds a trailing comma that `fe check`
// then rejects -- see docs/fe-findings.md.

/// What the verifier derives for `state_root` from `Fulu`.
const DERIVED_STATE_ROOT_GINDEX: u64 = payload_field_gindex<Fulu>(field: PAYLOAD_STATE_ROOT_FIELD)
static_assert(PAYLOAD_STATE_ROOT_GINDEX == DERIVED_STATE_ROOT_GINDEX)

/// What the verifier derives for `receipts_root` from `Fulu`.
const DERIVED_RECEIPTS_ROOT_GINDEX: u64 = payload_field_gindex<Fulu>(
    field: PAYLOAD_RECEIPTS_ROOT_FIELD,
)
static_assert(PAYLOAD_RECEIPTS_ROOT_GINDEX == DERIVED_RECEIPTS_ROOT_GINDEX)

/// What the verifier derives for `block_number` from `Fulu`.
const DERIVED_BLOCK_NUMBER_GINDEX: u64 = payload_field_gindex<Fulu>(
    field: PAYLOAD_BLOCK_NUMBER_FIELD,
)
static_assert(PAYLOAD_BLOCK_NUMBER_GINDEX == DERIVED_BLOCK_NUMBER_GINDEX)

/// What the verifier derives for `timestamp` from `Fulu`.
