//! The verifier: the chain of commitments, as functions that take a trusted
//! root and return proven facts.
//!
//! Every step is one of the pieces already built -- `header::require_header_root`,
//! `merkle::verify_vector_element`, `layout`'s derived gindices -- and this
//! module's only job is to put them in the one order that is sound, and to
//! refuse everything else. There is no new hashing here and no new arithmetic.
//!
//! ## What "trusted" means
//!
//! Exactly one input is trusted: `anchor_root`, which on chain comes from the
//! EIP-4788 system contract and in a test comes from a fixture that records the
//! `eth_call` proving it. Every other value is a claim, and each is accepted
//! only because hashing it reproduces something already trusted (invariant 1).
//! The functions below return what they proved, so a caller cannot mistake an
//! unproven field for a proven one.
//!
//! ## The recent path
//!
//! `BeaconState.block_roots` is a `Vector[Root, 8192]` covering the 8,192 slots
//! before the anchor. For a target in that window the proof is one branch out of
//! the anchor's state root, and `verify_recent` is the whole path:
//!
//! 1. the anchor header's five fields hash to `anchor_root` (step 2), which is
//!    what yields a `state_root` worth proving against;
//! 2. the target slot is inside the window and at or after Capella (invariant 9);
//! 3. the target header's five fields hash to a root, and that root is
//!    `block_roots[slot mod 8192]` (step 4);
//! 4. the target header's slot is the slot that was asked for (invariant 10).
//!
//! Only then is its `body_root` returned, and `payload_root_field` /
//! `payload_uint64_field` can reach a payload field from it (step 6).
//!
//! ## Why the fork appears twice
//!
//! `verify_recent<A, H>` takes the **anchor's** layout, because the branch it
//! walks is a branch of the anchor's `BeaconState`. `payload_root_field<T, H>`
//! takes the **target's**, because the branch it walks is a branch of the
//! target's block body. On the recent path those are usually the same fork;
//! across a fork boundary they are not, and the historical path makes the
//! difference routine. Keeping them as separate type parameters is what stops
//! a Deneb payload being read with Capella's field positions -- the mistake
//! `PIVOT_SLOT` and `PECTRA_FORK_TIMESTAMP` exist to avoid, made impossible
//! rather than avoided.

use ingot::hash::ChunkHasher
use ingot::header::{header_root, require_header_root, BeaconBlockHeader}
use ingot::gindex::vector_gindex
use ingot::layout::{
    block_root_gindex,
    fork_version_gindex,
    historical_summaries_length_gindex,
    payload_field_gindex,
    period_proof_len,
    slot_in_period,
    summary_block_root_gindex,
    summary_index,
    version_leaf,
    ForkLayout,
    ForkVersionProof,
    HistoricalProof,
    PayloadProof,
    RecentProof,
    CAPELLA_FIRST_SLOT,
    SLOTS_PER_HISTORICAL_ROOT,
}
use ingot::merkle::{root_from_branch, verify_branch}
use ingot::ssz::{uint64_from_leaf, uint64_leaf}

/// What a proven target header gives a caller.
///
/// Returned rather than asserted so that the next step cannot be taken against
/// an unproven root: `payload_root_field` needs a `body_root`, and the only way
/// to get one is for a header to have hashed to a proven block root first.
pub struct ProvenTarget {
    /// The target block's root, as proven out of the anchor state.
    pub root: u256,
    /// Its slot, equal to the slot the caller asked for (invariant 10).
    pub slot: u64,
    /// Its body root, where the execution payload hangs.
    pub body_root: u256,
}

/// What the historical path gives a caller: the proven target, and the period
/// commitment it was reached through.
///
/// `summary_root` is returned rather than discarded because it does not
/// expire. See `verify_in_period`.
pub struct ProvenHistorical {
    /// The target block, exactly as the recent path would return it.
    pub target: ProvenTarget,
    /// `historical_summaries[summary_index].block_summary_root`, proven out of
    /// the anchor state: the hash tree root of that period's 8,192
    /// `block_roots`.
    pub summary_root: u256,
    /// Which `historical_summaries` element that was. Derived from the target
    /// slot, never supplied.
    pub summary_index: u64,
}

/// Require the anchor state to commit to `A`'s fork version (invariant 8).
///
/// This is what makes the layout parameter honest. `A` is chosen by the caller
/// at compile time, and nothing so far has tied it to the chain: a Fulu anchor
/// verified with `A = Electra` would read `block_roots` at the right gindex (69
/// in both) and quietly succeed. Proving `state.fork.current_version` against
/// `version_leaf<A>()` closes that gap -- the chain itself has to agree that
/// the anchor is the fork the code was compiled for.
///
/// Reverts on a mismatch, which is also how the verifier fails closed on a
/// fork it does not know: a future version does not equal any `version_leaf`,
/// so no layout verifies it.
pub fn require_fork_version<A: ForkLayout, H: ChunkHasher>(
    hasher: H,
    state_root: u256,
    proof: ForkVersionProof<A>,
) {
    let proven = root_from_branch(
        hasher,
        leaf: version_leaf<A>(),
        gindex: fork_version_gindex<A>(),
        branch: proof.branch,
    )
    assert!(
        proven == state_root,
        "state.fork.current_version is not this layout's fork version",
    )
}

/// Prove `target_header` is the block at `target_slot`, out of an anchor state,
/// by the recent path.
///
/// `anchor_root` is the only trusted input. The anchor header is checked against
/// it before its `state_root` is used for anything, so a forged anchor header
/// cannot introduce a state root of its own.
pub fn verify_recent<A: ForkLayout, H: ChunkHasher>(
    hasher: H,
    anchor_root: u256,
    anchor_header: BeaconBlockHeader,
    target_slot: u64,
    target_header: BeaconBlockHeader,
    proof: RecentProof<A>,
) -> ProvenTarget {
    // Step 2. Nothing below may use `anchor_header` until this holds.
    require_header_root(hasher, header: anchor_header, root: anchor_root)

    // Invariant 9: VeriFe does not reach before Capella, where
    // `historical_summaries` begins and where these layouts start.
    assert!(
        target_slot >= CAPELLA_FIRST_SLOT,
        "target slot is before Capella",
    )

    // The recent window is the 8,192 slots before the anchor: `block_roots`
    // holds `[S - 8192, S - 1]`, and slot S itself is not in it -- the anchor
    // block's own root is not written into its own state.
    assert!(
        target_slot < anchor_header.slot,
        "target slot is at or after the anchor slot",
    )
    assert!(
        target_slot + SLOTS_PER_HISTORICAL_ROOT >= anchor_header.slot,
        "target slot is older than the anchor's block_roots window",
    )

    // Step 5 before step 4: hashing the claimed header is what produces the
    // root that the branch then has to prove. The other order -- walking the
    // branch to a leaf and trusting the caller's header -- would accept any
    // header whose root happened to be in the vector.
    let target_root = header_root(hasher, header: target_header)

    // Step 4. The position is `block_root_gindex<A>(index)`: the state field
    // spliced with the vector index, derived from the anchor's layout, with
    // `index` bounded against the vector's capacity inside `vector_gindex`.
    // No gindex crosses this call (invariant 2), and the branch's length is
    // already `block_root_proof_len<A>()` by its type, so a branch of the
    // wrong depth could not have been constructed.
    //
    // The branch is relative to the *state* root, not to the vector's, which
    // is why this is `verify_branch` over a composite gindex rather than
    // `merkle::verify_vector_element` -- that one is for a root that is itself
    // the vector's, as the rebuilt period vector will be on the historical
    // path.
    assert!(
        verify_branch(
            hasher,
            root: anchor_header.state_root,
            leaf: target_root,
            gindex: block_root_gindex<A>(index: slot_in_period(slot: target_slot)),
            branch: proof.branch,
        ),
        "block_roots does not commit to this header at this slot",
    )

    // Invariant 10. A missed slot leaves the previous slot's root in
    // `block_roots`, so the branch above verifies for a header whose slot is
    // *earlier* than the one asked for. Three of the four fork-activation slots
    // on mainnet are missed slots (`fixtures/README.md`), so this is the common
    // case, not a corner.
    assert!(
        target_header.slot == target_slot,
        "header.slot is not the slot asked for; the slot was missed",
    )

    ProvenTarget { root: target_root, slot: target_header.slot, body_root: target_header.body_root }
}

/// Prove `target_header` is the block at `target_slot` by the historical path,
/// for a target older than the anchor's `block_roots` window.
///
/// Four legs, and every root but the anchor's is *derived* rather than claimed.
/// The target header is hashed, the period branch carries that root up to a
/// period vector root, and the summary branch has to place *that* root in the
/// anchor state. A caller never supplies an intermediate value, so there is
/// nothing in between to forge:
///
/// 1. the anchor header hashes to `anchor_root` (step 2);
/// 2. the list's length is proven out of the mix-in leaf, and the summary index
///    derived from the target slot is checked against it (invariant 4);
/// 3. the target header hashes to a root, 13 levels of period branch carry it
///    to a period vector root, and the summary branch places that at
///    `historical_summaries[i].block_summary_root` in the anchor state (step 4);
/// 4. the target header's slot is the slot asked for (invariant 10).
///
/// `i` is derived from the proven slot by `summary_index`, never taken from the
/// caller -- the proof's own `index` field is checked against the derived value
/// rather than trusted. And the position within the summary is
/// `SUMMARY_BLOCK_ROOT_FIELD`, a constant spliced in by `const fn`, so field 1
/// (`state_summary_root`) is not reachable by any input. Those two facts are
/// the whole of the Lido 2025 bug class, closed by construction rather than by
/// check.
///
/// The recent path is preferred when both apply; this one does not forbid a
/// recent slot, because it does not need to. A period's summary only exists
/// once the period has completed, so `index < length` already rejects anything
/// too new, and that bound is proven rather than assumed.
pub fn verify_historical<A: ForkLayout, H: ChunkHasher>(
    hasher: H,
    anchor_root: u256,
    anchor_header: BeaconBlockHeader,
    target_slot: u64,
    target_header: BeaconBlockHeader,
    proof: HistoricalProof<A>,
) -> ProvenHistorical {
    // Step 2.
    require_header_root(hasher, header: anchor_header, root: anchor_root)

    // Invariant 9, and also what makes `summary_index` meaningful: there is no
    // summary for a period before the list began.
    assert!(
        target_slot >= CAPELLA_FIRST_SLOT,
        "target slot is before Capella",
    )
    let index = summary_index(slot: target_slot)
    assert!(
        proof.index == index,
        "the proof's summary index is not the one this slot implies",
    )

    // Invariant 4, in two halves that are only sound together. The length is a
    // claim, so it is proven: `uint64_leaf(length)` has to be the mix-in leaf
    // the anchor state commits to. Then it bounds the index.
    //
    // Without the proof, a prover could claim any length and reach a padded
    // slot past the end of the list -- which is a real node, with a real
    // branch, whose `block_summary_root` is zero. Without the bound, the
    // length would be proven and then ignored.
    let proven_length_root = root_from_branch(
        hasher,
        leaf: uint64_leaf(value: proof.length),
        gindex: historical_summaries_length_gindex<A>(),
        branch: proof.length_branch,
    )
    assert!(
        proven_length_root == anchor_header.state_root,
        "the claimed historical_summaries length is not the one committed to",
    )
    assert!(
        index < proof.length,
        "the period has no historical summary yet",
    )

    // Steps 5 and 4, inside the period: the same leg the cached path walks.
    let (target_root, period_root) = period_commitment(
        hasher,
        target_slot,
        target_header,
        period_branch: proof.period_branch,
    )

    // And the summary branch must place that period root at field 0 of element
    // `index`, at exactly the depth the layout says (invariant 3). The length
    // check above is what stops `index` naming a padded slot; this is what
    // stops the branch landing anywhere but `block_summary_root`.
    let proven_state_root = root_from_branch(
        hasher,
        leaf: period_root,
        gindex: summary_block_root_gindex<A>(index),
        branch: proof.summary_branch,
    )
    assert!(
        proven_state_root == anchor_header.state_root,
        "historical_summaries does not commit to this period at this index",
    )

    // Invariant 10, and it bites harder here: across a whole period the
    // rebuilt vector repeats a root at every missed slot, so several slots can
    // share one entry.
    assert!(
        target_header.slot == target_slot,
        "header.slot is not the slot asked for; the slot was missed",
    )

    ProvenHistorical {
        target: ProvenTarget {
            root: target_root,
            slot: target_header.slot,
            body_root: target_header.body_root,
        },
        summary_root: period_root,
        summary_index: index,
    }
}

/// The period commitment a claimed header implies: hash the header (step 5),
/// then walk the 13 levels of the period's `Vector[Root, 8192]` (step 4).
///
/// Returns `(target_root, summary_root)`. It does not decide what
/// `summary_root` has to equal, because the two historical paths disagree
/// about that and about nothing else: `verify_historical` proves it out of the
/// anchor state, `verify_in_period` compares it with one proven earlier. Both
/// call this, so neither can drift from the other.
///
/// 13 levels is the one depth in this library that does not depend on a fork:
/// a `Vector[Root, 8192]` is 13 levels in every layout, which is why this
/// function takes no `ForkLayout` parameter.
fn period_commitment<H: ChunkHasher>(
    hasher: H,
    target_slot: u64,
    target_header: BeaconBlockHeader,
    period_branch: [u256; period_proof_len()],
) -> (u256, u256) {
    let target_root = header_root(hasher, header: target_header)
    let summary_root = root_from_branch(
        hasher,
        leaf: target_root,
        gindex: vector_gindex(
            index: slot_in_period(slot: target_slot),
            capacity: SLOTS_PER_HISTORICAL_ROOT,
        ),
        branch: period_branch,
    )
    (target_root, summary_root)
}

/// Prove a target out of a period's `block_summary_root` that is **already
/// known**, with no anchor and no anchor layout.
///
/// This is the forward-compatible path, and the reason it exists is that
/// `historical_summaries` is append-only and the periods it commits to are
/// immutable. A `block_summary_root` is the hash tree root of 8,192 finalized
/// `block_roots`; once it has been proven out of an anchor state it is true
/// for ever. Everything below it -- this leg and the payload leg -- is
/// fork-independent or governed by the *target's* layout, and every target is
/// in the past.
///
/// So a verifier that stores the summary roots it proves goes on answering
/// through a fork it has never heard of: no EIP-4788 call, no
/// `fork.current_version` check, no anchor gindices, nothing that mentions the
/// live fork. Note what this signature does **not** have: no `A: ForkLayout`,
/// and no `AnchorSource` and so no effect row. On chain that is checked rather
/// than claimed -- an arm that calls this cannot declare `uses (call)` it does
/// not need, so the compiler is what shows this path makes no system call.
///
/// Be precise about what that is worth, because it is easy to overstate and
/// this doc did. The gain is **no redeployment**, plus a much cheaper query
/// and no need for the caller to hold a current `BeaconState`. It is *not*
/// that history would otherwise be lost: EIP-7732 changes the block body, not
/// `BeaconState.historical_summaries`, so a verifier recompiled for the next
/// fork's anchor layout could reach the same old periods from a fresh anchor.
/// What no deployment can reach is a block mined *after* an unpublished fork,
/// and the cache does not help with that either.
///
/// The caller owes one thing: `summary_root` must be a commitment this code
/// proved earlier, not an argument from calldata. `contract/` keeps them in
/// storage, written only by `verify_historical`'s result.
pub fn verify_in_period<H: ChunkHasher>(
    hasher: H,
    summary_root: u256,
    target_slot: u64,
    target_header: BeaconBlockHeader,
    period_branch: [u256; period_proof_len()],
) -> ProvenTarget {
    // Invariant 9. A cached root cannot be older than Capella anyway, but the
    // check is here rather than assumed: this function is `pub`.
    assert!(
        target_slot >= CAPELLA_FIRST_SLOT,
        "target slot is before Capella",
    )
    assert!(
        summary_root != 0,
        "there is no summary root for that period",
    )

    let (target_root, proven_summary_root) = period_commitment(
        hasher,
        target_slot,
        target_header,
        period_branch,
    )
    assert!(
        proven_summary_root == summary_root,
        "the period's block_summary_root does not commit to this block at this slot",
    )

    // Invariant 10, for the same reason as on the historical path: within a
    // period the vector repeats a root at every missed slot.
    assert!(
        target_header.slot == target_slot,
        "header.slot is not the slot asked for; the slot was missed",
    )

    ProvenTarget { root: target_root, slot: target_header.slot, body_root: target_header.body_root }
}

/// Prove a 32-byte `ExecutionPayload` field out of a proven `body_root`
/// (step 6).
///
/// `field` is one of `layout`'s `PAYLOAD_*_FIELD` constants, and the gindex is
/// derived from it and from `T`'s payload field count. For `block_hash`,
/// `state_root` and `receipts_root` the leaf *is* the value.
pub fn payload_root_field<T: ForkLayout, H: ChunkHasher>(
    hasher: H,
    target: ProvenTarget,
    field: u64,
    value: u256,
    proof: PayloadProof<T>,
) -> u256 {
    let proven = root_from_branch(
        hasher,
        leaf: value,
        gindex: payload_field_gindex<T>(field),
        branch: proof.branch,
    )
    assert!(
        proven == target.body_root,
        "the payload field does not belong to this block's body",
    )
    value
}

/// Prove a `uint64` `ExecutionPayload` field -- `block_number`, `timestamp` --
/// out of a proven `body_root`.
///
/// The leaf is the SSZ chunk and the value is the number inside it, so the
/// little-endian encoding is applied here and the strict decoder is what
/// rejects a chunk with a dirty padding byte (invariant 11). Taking the number
/// and re-encoding it, rather than taking the leaf and decoding it, means a
/// caller cannot hand over a leaf that decodes to something other than what
/// they claimed.
pub fn payload_uint64_field<T: ForkLayout, H: ChunkHasher>(
    hasher: H,
    target: ProvenTarget,
    field: u64,
    value: u64,
    proof: PayloadProof<T>,
) -> u64 {
    let leaf = uint64_leaf(value)
    let proven = root_from_branch(
        hasher,
        leaf,
        gindex: payload_field_gindex<T>(field),
        branch: proof.branch,
    )
    assert!(
        proven == target.body_root,
        "the payload field does not belong to this block's body",
    )
    // Belt and braces: the round trip must be exact, so a value that cannot be
    // an SSZ `uint64` cannot be smuggled through by a leaf that happens to
    // verify.
    assert!(
        uint64_from_leaf(leaf) == value,
        "value is not a uint64 leaf",
    )
    value
}

// --- Tests ------------------------------------------------------------------
//
// These run the real mainnet fixture through the real path on both backends.
// The data comes from `fixture_recent_fulu.fe`, generated from
// `fixtures/recent_fulu.json` by `tools/fixture_to_fe.py`; the JSON itself is
// checked by `tools/fixture_check.py`, which re-derives every root from
// `hashlib` alone. So the numbers below were produced by lodestar, verified by
// Python, and are verified again here by Fe.

use ingot::fixture_recent_fulu as fixture
use ingot::hash::SoftSha256
use ingot::layout::{
    Fulu,
    PAYLOAD_BLOCK_HASH_FIELD,
    PAYLOAD_BLOCK_NUMBER_FIELD,
    PAYLOAD_RECEIPTS_ROOT_FIELD,
    PAYLOAD_STATE_ROOT_FIELD,
    PAYLOAD_TIMESTAMP_FIELD,
}

#[test]
fn the_mainnet_recent_path_verifies() {
    // Slot 15,696,000 proven from the beacon block root that the EIP-4788
    // contract returns for timestamp 1795229027 -- an `eth_call` recorded in
    // the fixture, against the real contract on mainnet.
    let h = SoftSha256 {}
    let target = verify_recent<Fulu, SoftSha256>(
        hasher: h,
        anchor_root: fixture::ANCHOR_ROOT,
        anchor_header: fixture::anchor_header(),
        target_slot: fixture::TARGET_SLOT,
        target_header: fixture::target_header(),
        proof: fixture::recent_proof(),
    )
    assert!(target.slot == fixture::TARGET_SLOT)
    assert!(target.root == fixture::TARGET_ROOT)
    assert!(target.body_root == fixture::TARGET_BODY_ROOT)
}

#[test]
fn every_payload_field_of_the_mainnet_block_verifies() {
    let h = SoftSha256 {}
    let target = verify_recent<Fulu, SoftSha256>(
        hasher: h,
        anchor_root: fixture::ANCHOR_ROOT,
        anchor_header: fixture::anchor_header(),
        target_slot: fixture::TARGET_SLOT,
        target_header: fixture::target_header(),
        proof: fixture::recent_proof(),
    )

    // The three roots, where the leaf is the value.
    assert!(
        payload_root_field<Fulu, SoftSha256>(
                hasher: h,
                target,
                field: PAYLOAD_BLOCK_HASH_FIELD,
                value: fixture::PAYLOAD_BLOCK_HASH,
                proof: fixture::block_hash_proof(),
            )
            == fixture::PAYLOAD_BLOCK_HASH,
    )
    assert!(
        payload_root_field<Fulu, SoftSha256>(
                hasher: h,
                target,
                field: PAYLOAD_STATE_ROOT_FIELD,
                value: fixture::PAYLOAD_STATE_ROOT,
                proof: fixture::state_root_proof(),
            )
            == fixture::PAYLOAD_STATE_ROOT,
    )
    assert!(
        payload_root_field<Fulu, SoftSha256>(
                hasher: h,
                target,
                field: PAYLOAD_RECEIPTS_ROOT_FIELD,
                value: fixture::PAYLOAD_RECEIPTS_ROOT,
                proof: fixture::receipts_root_proof(),
            )
            == fixture::PAYLOAD_RECEIPTS_ROOT,
    )

    // And the two `uint64`s, through the little-endian codec.
    assert!(
        payload_uint64_field<Fulu, SoftSha256>(
                hasher: h,
                target,
                field: PAYLOAD_BLOCK_NUMBER_FIELD,
                value: fixture::PAYLOAD_BLOCK_NUMBER,
                proof: fixture::block_number_proof(),
            )
            == fixture::PAYLOAD_BLOCK_NUMBER,
    )
    assert!(
        payload_uint64_field<Fulu, SoftSha256>(
                hasher: h,
                target,
                field: PAYLOAD_TIMESTAMP_FIELD,
                value: fixture::PAYLOAD_TIMESTAMP,
                proof: fixture::timestamp_proof(),
            )
            == fixture::PAYLOAD_TIMESTAMP,
    )
}

#[test]
fn the_anchor_state_commits_to_the_fulu_fork_version() {
    // Invariant 8 against real data: the chain agrees that this anchor is Fulu.
    let h = SoftSha256 {}
    require_fork_version<Fulu, SoftSha256>(
        hasher: h,
        state_root: fixture::ANCHOR_STATE_ROOT,
        proof: fixture::fork_version_proof(),
    )
}

#[test(should_revert)]
fn a_forged_anchor_header_is_rejected() {
    // Invariant 1. The anchor root is the only trusted input, so an attacker's
    // lever is the header offered against it -- here with a state root of
    // their choosing, which would let them prove anything at all.
    //
    // Also not isolated: a forged `state_root` both fails to hash to the
    // anchor root *and* breaks every branch proven against it. Isolating
    // `require_header_root` needs a header that hashes to the anchor root
    // while carrying a different state root, which is a SHA-256 collision.
    // The guard is unfalsifiable by test and correct by construction.
    let h = SoftSha256 {}
    var forged = fixture::anchor_header()
    forged.state_root = 0xdead
    let _ = verify_recent<Fulu, SoftSha256>(
        hasher: h,
        anchor_root: fixture::ANCHOR_ROOT,
        anchor_header: forged,
        target_slot: fixture::TARGET_SLOT,
        target_header: fixture::target_header(),
        proof: fixture::recent_proof(),
    )
}

// --- What these negative tests do and do not isolate ------------------------
//
// Each of the four guards in `verify_recent` was removed in turn and the suite
// re-run. **All 70 tests stayed green every time.** The tests below are
// therefore not one-guard-each, and saying otherwise would be false. The
// reason is structural rather than sloppy:
//
//   * Inside one 8,192-slot window, slot and vector index are one-to-one (two
//     slots share an index only 8,192 apart, which does not fit in the
//     window). So asking for a different in-window slot changes the gindex and
//     the branch simply fails. The branch check subsumes the slot checks for
//     every input *except* one.
//   * That exception is a **missed slot**, where `block_roots` holds the
//     previous block's root twice. Then two slots really do map to one root,
//     the branch verifies for the earlier header, and `header.slot == s`
//     (invariant 10) is the only thing left to reject it. That is the whole
//     purpose of invariant 10, and it cannot be exercised without a missed-slot
//     fixture -- `fixtures/README.md` records the three fork-activation slots
//     that are missed, and a missed slot inside this anchor's own window is
//     being extracted from the cached state for exactly this test.
//   * The window and anchor-slot bounds are defence in depth against a caller
//     error, the same relationship the two length guards in `root_from_branch`
//     have: either one alone rejects these inputs, so no behavioural test can
//     tell them apart. They stay because they fail early and name the problem.
//
// So what follows is honest about its own reach: it proves the path rejects
// these inputs, not that each named guard is what rejects them.

#[test(should_revert)]
fn the_wrong_slot_for_a_real_header_is_rejected() {
    // Rejected, though by the branch rather than by invariant 10: the slot
    // next door has a different vector index, so the siblings no longer carry
    // this header to the state root.
    let h = SoftSha256 {}
    let _ = verify_recent<Fulu, SoftSha256>(
        hasher: h,
        anchor_root: fixture::ANCHOR_ROOT,
        anchor_header: fixture::anchor_header(),
        target_slot: fixture::TARGET_SLOT + 1,
        target_header: fixture::target_header(),
        proof: fixture::recent_proof(),
    )
}

#[test(should_revert)]
fn a_target_at_the_anchor_slot_is_rejected() {
    // `block_roots` covers [S - 8192, S - 1]: a block's own root is not in its
    // own state, so asking for the anchor's slot is a caller error rather than
    // a proof that fails to verify. The explicit bound names it; without the
    // bound the branch would reject it anyway.
    let h = SoftSha256 {}
    let _ = verify_recent<Fulu, SoftSha256>(
        hasher: h,
        anchor_root: fixture::ANCHOR_ROOT,
        anchor_header: fixture::anchor_header(),
        target_slot: fixture::ANCHOR_SLOT,
        target_header: fixture::target_header(),
        proof: fixture::recent_proof(),
    )
}

#[test(should_revert)]
fn a_target_older_than_the_window_is_rejected() {
    let h = SoftSha256 {}
    let _ = verify_recent<Fulu, SoftSha256>(
        hasher: h,
        anchor_root: fixture::ANCHOR_ROOT,
        anchor_header: fixture::anchor_header(),
        target_slot: fixture::ANCHOR_SLOT - SLOTS_PER_HISTORICAL_ROOT - 1,
        target_header: fixture::target_header(),
        proof: fixture::recent_proof(),
    )
}

#[test(should_revert)]
fn a_payload_field_proven_at_the_wrong_position_is_rejected() {
    // The `block_hash` branch, offered as a proof of `state_root`. Both are
    // 9-level branches of the same body, so only the gindex distinguishes
    // them -- and the gindex is derived from the field constant, not supplied.
    let h = SoftSha256 {}
    let target = verify_recent<Fulu, SoftSha256>(
        hasher: h,
        anchor_root: fixture::ANCHOR_ROOT,
        anchor_header: fixture::anchor_header(),
        target_slot: fixture::TARGET_SLOT,
        target_header: fixture::target_header(),
        proof: fixture::recent_proof(),
    )
    let _ = payload_root_field<Fulu, SoftSha256>(
        hasher: h,
        target,
        field: PAYLOAD_STATE_ROOT_FIELD,
        value: fixture::PAYLOAD_BLOCK_HASH,
        proof: fixture::block_hash_proof(),
    )
}

#[cfg(target = "evm")]
#[test]
fn the_mainnet_path_gives_the_same_answer_through_the_precompile() {
    // The differential property on real data: the same fixture, the same
    // verdict, whichever SHA-256 the target has. This is what lets a native
    // CLI verdict and an on-chain verdict be compared.
    let fast = ingot::hash::PrecompileSha256 {}
    let target = verify_recent<Fulu, ingot::hash::PrecompileSha256>(
        hasher: fast,
        anchor_root: fixture::ANCHOR_ROOT,
        anchor_header: fixture::anchor_header(),
        target_slot: fixture::TARGET_SLOT,
        target_header: fixture::target_header(),
        proof: fixture::recent_proof(),
    )
    assert!(target.body_root == fixture::TARGET_BODY_ROOT)
    assert!(
        payload_root_field<Fulu, ingot::hash::PrecompileSha256>(
                hasher: fast,
                target,
                field: PAYLOAD_BLOCK_HASH_FIELD,
                value: fixture::PAYLOAD_BLOCK_HASH,
                proof: fixture::block_hash_proof(),
            )
            == fixture::PAYLOAD_BLOCK_HASH,
    )
}

// --- The missed-slot attack, on real mainnet data ---------------------------

use ingot::fixture_missed_slot_fulu as missed

#[test(should_revert)]
fn the_missed_slot_attack_is_rejected() {
    // Invariant 10, isolated at last, and the only test in this file that
    // isolates anything in `verify_recent`.
    //
    // Slot 15,694,457 was missed on mainnet, so `block_roots[6777]` holds slot
    // 15,694,456's root twice. Everything offered here is genuine: the anchor
    // header hashes to the anchor root, the branch is a real 19-level branch of
    // the anchor state, and gindex 572025 really is the position of the claimed
    // slot. The header is in `block_roots` -- it is simply the wrong slot's.
    //
    // Only `header.slot == target_slot` rejects it. Removing that assert makes
    // this test fail, which is the whole point of writing it.
    let h = SoftSha256 {}
    let _ = verify_recent<Fulu, SoftSha256>(
        hasher: h,
        anchor_root: missed::ANCHOR_ROOT,
        anchor_header: missed::anchor_header(),
        target_slot: missed::CLAIMED_SLOT,
        target_header: missed::repeated_header(),
        proof: missed::recent_proof(),
    )
}

#[test]
fn the_offered_branch_is_genuine() {
    // What makes the test above meaningful: the branch really does prove that
    // this header's root sits at the claimed slot's position in `block_roots`.
    // Nothing is broken or mismatched about it -- the proof is sound and the
    // claim is still a lie, which is the only reason invariant 10 has to exist.
    let h = SoftSha256 {}
    assert!(
        verify_branch(
            hasher: h,
            root: missed::ANCHOR_STATE_ROOT,
            leaf: missed::REPEATED_HEADER_ROOT,
            gindex: block_root_gindex<Fulu>(index: missed::BLOCK_ROOTS_INDEX),
            branch: missed::recent_proof().branch,
        ),
    )
    // The repeated header hashes to that root, so it is a real header and not
    // a forgery: both halves of the lie are individually true.
    assert!(
        header_root(hasher: h, header: missed::repeated_header()) == missed::REPEATED_HEADER_ROOT,
    )
    // And it is the *previous* slot, which is what a missed slot leaves behind.
    assert!(missed::repeated_header().slot == missed::CLAIMED_SLOT - 1)
    assert!(missed::BLOCK_ROOTS_INDEX == missed::CLAIMED_SLOT % 8192)
}

// --- The historical path, across a fork boundary -----------------------------

use ingot::fixture_historical_capella as historical_fixture
use ingot::layout::{Capella, Electra}

#[test]
fn the_first_capella_block_verifies_from_a_fulu_anchor() {
    // The pitch, on real data: slot 6,209,538 -- the first block Capella ever
    // produced -- proven from a Fulu anchor 9,490,878 slots later, about three
    // and a half years, from one EIP-4788 root.
    //
    // Note the two layouts. The state-side branches are Fulu's, because they
    // are branches of a Fulu `BeaconState`; the payload branch is Capella's,
    // because it is a branch of a Capella block body. Neither could stand in
    // for the other: `HistoricalProof<Capella>` would not type here, and
    // Capella's payload is 8 levels where Fulu's is 9.
    let h = SoftSha256 {}
    let target = verify_historical<Fulu, SoftSha256>(
        hasher: h,
        anchor_root: historical_fixture::ANCHOR_ROOT,
        anchor_header: historical_fixture::anchor_header(),
        target_slot: historical_fixture::TARGET_SLOT,
        target_header: historical_fixture::target_header(),
        proof: historical_fixture::historical_proof(),
    )
        .target
    assert!(target.slot == historical_fixture::TARGET_SLOT)
    assert!(target.root == historical_fixture::TARGET_ROOT)
    assert!(target.body_root == historical_fixture::TARGET_BODY_ROOT)

    // And the payload field, at the target's layout.
    assert!(
        payload_root_field<Capella, SoftSha256>(
                hasher: h,
                target,
                field: PAYLOAD_BLOCK_HASH_FIELD,
                value: historical_fixture::PAYLOAD_BLOCK_HASH,
                proof: historical_fixture::block_hash_proof(),
            )
            == historical_fixture::PAYLOAD_BLOCK_HASH,
    )
    assert!(
        payload_uint64_field<Capella, SoftSha256>(
                hasher: h,
                target,
                field: PAYLOAD_BLOCK_NUMBER_FIELD,
                value: historical_fixture::PAYLOAD_BLOCK_NUMBER,
                proof: historical_fixture::block_number_proof(),
            )
            == historical_fixture::PAYLOAD_BLOCK_NUMBER,
    )
}

// Invariant 4's bound is *not* isolated by any test here, and cannot be by
// this chain. Removing `index < proof.length` leaves all tests green, because
// an index past the end of the list reaches a padded slot whose
// `block_summary_root` is zero -- and a prover then needs a period branch
// carrying their header's root up to zero, which is a preimage of zero. The
// subsequent legs make a past-the-end index unexploitable on their own.
//
// The bound stays because it is one comparison, it fails early with a clear
// message, and it would matter to any caller that used a proven
// `block_summary_root` directly rather than continuing through the period
// vector -- which is the shape Lido's verifier had. It is defence in depth,
// and the test below says what it really demonstrates: the rejection of a
// slot whose period has not been summarised yet.

#[test(should_revert)]
fn a_slot_in_an_unsummarised_period_is_rejected() {
    // A real caller error rather than an attack: asking the historical path
    // for a slot near the anchor. The anchor is in period 1,916, whose summary
    // does not exist yet -- `historical_summaries` holds 1,158 entries, for
    // periods 758 to 1,915 -- so the derived index equals the proven length
    // and there is nothing to read. The recent path is what serves this slot.
    let h = SoftSha256 {}
    let _ = verify_historical<Fulu, SoftSha256>(
        hasher: h,
        anchor_root: historical_fixture::ANCHOR_ROOT,
        anchor_header: historical_fixture::anchor_header(),
        target_slot: historical_fixture::ANCHOR_SLOT - 100,
        target_header: historical_fixture::target_header(),
        proof: historical_fixture::historical_proof(),
    )
}

#[test(should_revert)]
fn a_forged_length_does_not_survive_the_mix_in() {
    // Invariant 4's other half. The real list holds 1,158 summaries; claiming
    // a different number changes the mix-in leaf, so the length branch no
    // longer reaches the anchor state root. This is what stops the bound above
    // from being bypassed by simply claiming a larger list.
    let h = SoftSha256 {}
    var proof = historical_fixture::historical_proof()
    proof.length = historical_fixture::SUMMARY_LENGTH + 1
    let _ = verify_historical<Fulu, SoftSha256>(
        hasher: h,
        anchor_root: historical_fixture::ANCHOR_ROOT,
        anchor_header: historical_fixture::anchor_header(),
        target_slot: historical_fixture::TARGET_SLOT,
        target_header: historical_fixture::target_header(),
        proof,
    )
}

#[test(should_revert)]
fn a_summary_index_that_is_not_the_slot_s_own_is_rejected() {
    // The index is derived from the proven slot by `summary_index`, so a proof
    // that names a different one is refused before any hashing. A caller
    // cannot choose which period to read.
    let h = SoftSha256 {}
    var proof = historical_fixture::historical_proof()
    proof.index = historical_fixture::SUMMARY_INDEX + 1
    let _ = verify_historical<Fulu, SoftSha256>(
        hasher: h,
        anchor_root: historical_fixture::ANCHOR_ROOT,
        anchor_header: historical_fixture::anchor_header(),
        target_slot: historical_fixture::TARGET_SLOT,
        target_header: historical_fixture::target_header(),
        proof,
    )
}

#[test(should_revert)]
fn the_period_branch_cannot_be_offered_for_another_slot_in_the_period() {
    // The period vector holds 8,192 roots and this target sits at index 2. Ask
    // for a different slot in the same period and the vector index changes, so
    // the 13-level branch no longer carries this header.
    let h = SoftSha256 {}
    let _ = verify_historical<Fulu, SoftSha256>(
        hasher: h,
        anchor_root: historical_fixture::ANCHOR_ROOT,
        anchor_header: historical_fixture::anchor_header(),
        target_slot: historical_fixture::TARGET_SLOT + 1,
        target_header: historical_fixture::target_header(),
        proof: historical_fixture::historical_proof(),
    )
}

#[test]
fn the_historical_proof_has_the_shape_its_layout_implies() {
    // The lengths are not written anywhere in the fixture or here: they come
    // from `const fn`s of Fulu's field count. 32 = state 6 + list mix-in 1 +
    // 24 element levels + 1 field; 7 = state 6 + the mix-in level; 13 is the
    // period vector, which is 13 in every fork.
    let proof = historical_fixture::historical_proof()
    assert!(
        proof.summary_branch.len() == ingot::layout::summary_block_root_proof_len<Fulu>(),
    )
    assert!(
        proof.length_branch.len() == ingot::layout::summary_length_proof_len<Fulu>(),
    )
    assert!(
        proof.period_branch.len() == ingot::layout::period_proof_len(),
    )
    assert!(proof.summary_branch.len() == 32)
    assert!(proof.length_branch.len() == 7)
    assert!(proof.period_branch.len() == 13)
}

#[cfg(target = "evm")]
#[test]
fn the_historical_path_agrees_through_the_precompile() {
    let fast = ingot::hash::PrecompileSha256 {}
    let target = verify_historical<Fulu, ingot::hash::PrecompileSha256>(
        hasher: fast,
        anchor_root: historical_fixture::ANCHOR_ROOT,
        anchor_header: historical_fixture::anchor_header(),
        target_slot: historical_fixture::TARGET_SLOT,
        target_header: historical_fixture::target_header(),
        proof: historical_fixture::historical_proof(),
    )
        .target
    assert!(target.root == historical_fixture::TARGET_ROOT)
}

// --- Invariant 8, which nothing was testing --------------------------------
//
// Found by deleting `require_fork_version`'s only assertion and watching all
// 339 tests pass. The guard was correct; nothing proved it worked.
//
// This matters more than most: invariant 8 is the **fail-closed mechanism**.
// The claim that an anchored arm will revert at the next hard fork rather than
// mis-verify rests entirely on this check, and the claim was untested.

#[test(should_revert)]
fn a_state_whose_fork_version_is_not_the_layout_s_is_rejected() {
    // The real shape of the mistake: a Fulu anchor state, read with Electra's
    // layout. `version_leaf<Electra>()` is 0x05000000 where the state holds
    // 0x06000000, so the branch no longer reaches the state root.
    //
    // This is what makes the library fail closed at a fork it does not know.
    // At Glamsterdam the state's version becomes 0x07000000, no layout's
    // `version_leaf` matches it, and every anchored arm reverts here instead
    // of reading a payload with field positions that have moved.
    let h = SoftSha256 {}
    require_fork_version<Electra, SoftSha256>(
        hasher: h,
        state_root: fixture::ANCHOR_STATE_ROOT,
        proof: ForkVersionProof<Electra> { branch: fixture::fork_version_proof().branch },
    )
}

#[test(should_revert)]
fn a_forged_fork_version_branch_is_rejected() {
    // And one bit of the branch, so the test above cannot be passing merely
    // because `Electra` and `Fulu` disagree about the branch *length*.
    let h = SoftSha256 {}
    var proof = fixture::fork_version_proof()
    proof.branch[0] = proof.branch[0] ^ 1
    require_fork_version<Fulu, SoftSha256>(hasher: h, state_root: fixture::ANCHOR_STATE_ROOT, proof)
}

#[test]
fn and_the_real_fork_version_is_accepted() {
    // The control. Without it both tests above would pass against a
    // `require_fork_version` that rejected everything.
    let h = SoftSha256 {}
    require_fork_version<Fulu, SoftSha256>(
        hasher: h,
        state_root: fixture::ANCHOR_STATE_ROOT,
        proof: fixture::fork_version_proof(),
    )
}
