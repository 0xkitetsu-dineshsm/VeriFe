//! Merkle-Patricia trie lookup: present, absent, or refused.
//!
//! This is the leg that turns a proven `state_root` or `receipts_root` into an
//! actual account, storage slot or receipt. VeriFe's SSZ half establishes
//! those two roots for any post-Capella block from one EIP-4788 beacon root;
//! everything in this module happens *below* them, in the execution layer's
//! own trie.
//!
//! ## The shape of a proof
//!
//! A proof is an RLP list of node encodings, in path order from the root --
//! the same `bytes[]` the Solidity verifiers take, and what `eth_getProof`
//! returns. Because it is itself RLP, `rlp.fe` walks it, and nothing is
//! copied: a node is an offset and a length into the caller's buffer.
//!
//! Each node is addressed by `keccak256` of its own encoding, so the walk
//! carries an `expected` hash: the root to begin with, then whichever child
//! reference the previous node named. A node whose bytes do not hash to the
//! reference that led to it is refused. That check, plus RLP canonicality, is
//! what makes "this node is on the path" mean anything.
//!
//! ## Proving absence
//!
//! A lookup that fails has to fail *provably*, not by running out of nodes.
//! There are three honest ways a key is absent, and all three are reached
//! through a verified path:
//!
//!   1. the branch slot for the next nibble is empty;
//!   2. a leaf or extension's path diverges from the key;
//!   3. a leaf's path ends before the key does.
//!
//! Anything else -- a missing node, a node that does not hash, a malformed
//! encoding -- reverts. Optimism's audited `MerkleTrie` cannot prove absence
//! at all, so a zero balance or an absent account is unreadable with it; Lido's
//! `StateProofVerifier` accepts a proof that simply stops after a branch node
//! and reads the slot as zero, which is the bug class Roman Agureev found in
//! March 2025. Running out of nodes here is a revert, never a zero.
//!
//! ## What is not done yet
//!
//! `ExtraNodes`: a proof carrying nodes beyond the path is accepted, because
//! the value is still proven by the path that was walked. It is a malleability
//! wart rather than a soundness hole, and rejecting it is a one-line change
//! once the real fixtures confirm no honest proof trips it.

use core::ptr::MemSpan
use ingot::hash::ByteHasher
use ingot::rlp::{self, Item}

/// Where a lookup landed.
///
/// `present` is false only for the three proven absences in the module note;
/// every other outcome reverts. When `present` is true the value is the
/// `value_len` bytes at `value_at` in the caller's buffer -- an account's RLP
/// for a state-trie lookup, an RLP integer for a storage slot.
pub struct Lookup { pub present: bool, pub value_at: usize, pub value_len: usize }

/// The `index`-th nibble of the byte string at `offset`, counting from the
/// high nibble of the first byte.
fn nibble(_ buf: MemSpan, offset: usize, index: usize) -> u8 {
    let byte = buf[offset + index / 2]
    if index % 2 == 0 {
        byte >> 4
    } else {
        byte & 0x0f
    }
}

/// Walk `proof` from `root` looking for `key`.
///
/// `key_len` is in bytes, and it is a parameter because the tries Ethereum
/// uses do not agree on it. The state and storage tries key by `keccak256` of
/// an address or a slot, so 32 bytes. The **receipts and transactions tries
/// key by `rlp(index)`, unhashed**, so one or two. A verifier that assumed 32
/// would read a receipt proof as a path running off the end of its key --
/// which this one did, until a real receipt proof was built for it.
///
/// The key is hashed, or not, by the caller: which preimage a trie wants is
/// the caller's business, and getting it wrong should not be representable
/// here.
pub fn lookup<K: ByteHasher>(
    hasher: K,
    _ buf: MemSpan,
    proof: Item,
    root: u256,
    key: MemSpan,
    key_offset: usize,
    key_len: usize,
) -> Lookup {
    assert!(proof.is_list, "mpt: a proof is a list of nodes")
    assert!(key_len > 0, "mpt: an empty trie key")
    assert!(
        key.len() >= key_offset + key_len,
        "mpt: the key runs past its buffer",
    )
    let key_nibbles: usize = key_len * 2

    var expected = root
    var nib: usize = 0
    var element = rlp::first(buf, list: proof)
    var node_at = element.offset
    var node_len = element.len
    // An embedded node is the parent's own bytes; it is covered by the
    // parent's hash and must not be hashed again on its own.
    var hash_it = true

    while true {
        if hash_it {
            assert!(
                hasher.keccak(buf.slice(offset: node_at, len: node_len)) == expected,
                "mpt: a node does not hash to the reference that led to it",
            )
        }

        let node = rlp::read_item(buf, at: node_at)
        assert!(node.is_list, "mpt: a node is an RLP list")
        let items = rlp::count(buf, list: node)

        if items == 17 {
            // A branch. Seventeen slots: one per nibble, plus a value.
            if nib == key_nibbles {
                let value = rlp::nth(buf, list: node, index: 16)
                if value.len == 0 {
                    return Lookup { present: false, value_at: 0, value_len: 0 }
                }
                return Lookup { present: true, value_at: value.offset, value_len: value.len }
            }
            let which = nibble(key, offset: key_offset, index: nib) as usize
            let child = rlp::nth(buf, list: node, index: which)
            nib += 1

            // Absence 1: nothing down that nibble.
            if child.len == 0 {
                return Lookup { present: false, value_at: 0, value_len: 0 }
            }
            if child.len == 32 {
                expected = rlp::read_hash(buf, item: child)
                element = rlp::next(buf, list: proof, item: element)
                node_at = element.offset
                node_len = element.len
                hash_it = true
            } else {
                // Embedded: the child's encoding is inline in this node.
                node_at = child.start()
                node_len = child.total_len()
                hash_it = false
            }
            continue
        }

        assert!(
            items == 2,
            "mpt: a node is a branch of 17 or a leaf/extension of 2",
        )
        let path = rlp::nth(buf, list: node, index: 0)
        let rest = rlp::nth(buf, list: node, index: 1)
        assert!(path.len >= 1, "mpt: an empty hex-prefix path")

        // Hex-prefix: the top nibble of the first byte says leaf or extension
        // and whether the nibble count is odd.
        let flags = buf[path.offset] >> 4
        assert!(flags <= 3, "mpt: hex-prefix flags out of range")
        let is_leaf = flags >= 2
        let odd = flags % 2 == 1
        if !odd {
            // An even-length path pads with a zero nibble, and a non-zero one
            // would be a second encoding of the same path.
            assert!(
                buf[path.offset] & 0x0f == 0,
                "mpt: hex-prefix padding nibble is not zero",
            )
        }
        let skip: usize = if odd { 1 } else { 2 }
        let path_len = path.len * 2 - skip

        var step: usize = 0
        while step < path_len {
            // Absence 3, for a path that outruns the key.
            if nib + step >= key_nibbles {
                return Lookup { present: false, value_at: 0, value_len: 0 }
            }
            // Absence 2: the path diverges.
            if nibble(buf, offset: path.offset, index: skip + step)
                != nibble(key, offset: key_offset, index: nib + step) {
                return Lookup { present: false, value_at: 0, value_len: 0 }
            }
            step += 1
        }
        nib += path_len

        if is_leaf {
            // A leaf ends the key or it is not this key's leaf.
            if nib != key_nibbles {
                return Lookup { present: false, value_at: 0, value_len: 0 }
            }
            return Lookup { present: true, value_at: rest.offset, value_len: rest.len }
        }

        // An extension names its child the same two ways a branch slot does.
        if rest.len == 32 {
            expected = rlp::read_hash(buf, item: rest)
            element = rlp::next(buf, list: proof, item: element)
            node_at = element.offset
            node_len = element.len
            hash_it = true
        } else {
            node_at = rest.start()
            node_len = rest.total_len()
            hash_it = false
        }
    }

    // Unreachable: every branch of the loop either returns or continues, and
    // running out of proof nodes reverts inside `rlp::next`.
    Lookup { present: false, value_at: 0, value_len: 0 }
}

// --- Tests ------------------------------------------------------------------
//
// The execution-layer tests are native-only, and the reason is a `fe test`
// limit rather than anything about the verifier: the EVM test suite is
// deployed as a single contract, so these fixtures' byte arrays count against
// EIP-170 and four of them do not fit beside the SSZ ones. `mpt::lookup` is
// the same code on both backends; what differs is the hasher, and
// `hash.fe`'s `both_byte_hashers_agree` checks the opcode against the software
// implementation on the EVM target with no fixture data at all.
// See docs/fe-findings.md.
//
// Every proof below is one a mainnet node served for block 26,472,617, and
// every expected value is what it reported for the same key. So these are
// differential tests against geth's own trie, not against our reading of the
// spec. See `fixture_mpt_mainnet.fe` for the provenance.

use core::ptr::MemBuffer
#[cfg(target = "native")]
use ingot::fixture_mpt_mainnet as m
use ingot::hash::SoftKeccak

/// A `u256` as the 32 big-endian bytes a trie key is.
#[cfg(target = "native")]
fn key_of(_ value: u256) -> MemBuffer {
    var buf = MemBuffer::new(0)
    var byte: u8 = 32
    while byte > 0 {
        byte -= 1
        buf.push(((value >> (byte as u256 * 8)) & 0xff).downcast_truncate())
    }
    buf
}

#[cfg(target = "native")]
#[test]
fn a_real_mainnet_account_is_found_in_the_state_trie() {
    let hasher = SoftKeccak {}
    var proof_buf = m::account_proof()
    let buf = proof_buf.span()
    var key_buf = key_of(m::ACCOUNT_KEY)

    let found = lookup(
        hasher,
        buf,
        proof: rlp::read_item(buf, at: 0),
        root: m::STATE_ROOT,
        key: key_buf.span(),
        key_offset: 0,
        key_len: 32,
    )
    assert!(found.present, "USDC's account is in the state trie")

    // The value is the account: an RLP list of nonce, balance, storageRoot,
    // codeHash. All four are checked against what the node reported.
    let account = rlp::read_item(buf, at: found.value_at - 0)
    assert!(account.is_list)
    assert!(rlp::count(buf, list: account) == 4)
    assert!(
        rlp::read_uint(buf, item: rlp::nth(buf, list: account, index: 0)) == m::ACCOUNT_NONCE,
    )
    assert!(
        rlp::read_uint(buf, item: rlp::nth(buf, list: account, index: 1)) == m::ACCOUNT_BALANCE,
    )
    assert!(
        rlp::read_hash(buf, item: rlp::nth(buf, list: account, index: 2))
            == m::ACCOUNT_STORAGE_ROOT,
    )
    assert!(
        rlp::read_hash(buf, item: rlp::nth(buf, list: account, index: 3)) == m::ACCOUNT_CODE_HASH,
    )
}

#[cfg(target = "native")]
#[test]
fn a_present_storage_slot_is_found() {
    // Slot 0 of USDC, whose value is the proxy's implementation address --
    // proven out of the storage root the account proof above established.
    let hasher = SoftKeccak {}
    var proof_buf = m::slot_0_proof()
    let buf = proof_buf.span()
    var key_buf = key_of(m::SLOT_0_KEY)

    let found = lookup(
        hasher,
        buf,
        proof: rlp::read_item(buf, at: 0),
        root: m::ACCOUNT_STORAGE_ROOT,
        key: key_buf.span(),
        key_offset: 0,
        key_len: 32,
    )
    assert!(found.present, "slot 0 is set")
    assert!(m::SLOT_0_PRESENT)
    let value = rlp::read_uint(buf, item: rlp::read_item(buf, at: found.value_at))
    assert!(value == m::SLOT_0_VALUE)
}

#[cfg(target = "native")]
#[test]
fn an_absent_storage_slot_is_proven_absent() {
    // A slot nobody has ever written. This is the case Optimism's audited
    // verifier cannot handle at all -- it reverts on a valid proof of absence
    // -- so "absent" has to be a verdict and not a failure.
    let hasher = SoftKeccak {}
    var proof_buf = m::slot_1_proof()
    let buf = proof_buf.span()
    var key_buf = key_of(m::SLOT_1_KEY)

    let found = lookup(
        hasher,
        buf,
        proof: rlp::read_item(buf, at: 0),
        root: m::ACCOUNT_STORAGE_ROOT,
        key: key_buf.span(),
        key_offset: 0,
        key_len: 32,
    )
    assert!(!found.present, "the slot is absent, and provably so")
    assert!(!m::SLOT_1_PRESENT)
    assert!(m::SLOT_1_VALUE == 0)
}

#[cfg(target = "native")]
#[test]
fn an_account_with_no_storage_carries_the_empty_trie_root() {
    let hasher = SoftKeccak {}
    var proof_buf = m::eoa_proof()
    let buf = proof_buf.span()
    var key_buf = key_of(m::EOA_KEY)

    let found = lookup(
        hasher,
        buf,
        proof: rlp::read_item(buf, at: 0),
        root: m::STATE_ROOT,
        key: key_buf.span(),
        key_offset: 0,
        key_len: 32,
    )
    assert!(found.present)
    let account = rlp::read_item(buf, at: found.value_at)
    let storage_root = rlp::read_hash(buf, item: rlp::nth(buf, list: account, index: 2))
    assert!(storage_root == m::EOA_STORAGE_ROOT)
    // And that is the empty-trie root, which `hash.fe` pins independently.
    assert!(
        storage_root == 0x56e81f171bcc55a6ff8345e692c0f86e5b48e01b996cadc001622fb5e363b421,
    )
}

#[cfg(target = "native")]
#[test(should_revert)]
fn a_proof_that_stops_early_is_refused_and_not_read_as_absent() {
    // **The March 2025 bug class, as a test.** Lido's audited
    // `StateProofVerifier` accepts a proof whose node list ends after a branch
    // node and reports the slot as zero; Roman Agureev found it and
    // ChainSecurity coordinated the disclosure. The proof here is the genuine
    // mainnet account proof with its final node removed -- every node in it is
    // real and hashes correctly, and the walk is sound right up to the point
    // where the next node is simply not there.
    //
    // Returning "absent" here would be the bug. Reverting is the whole point
    // of the module: running out of nodes is never a verdict.
    let hasher = SoftKeccak {}
    var proof_buf = m::account_proof_truncated()
    let buf = proof_buf.span()
    var key_buf = key_of(m::ACCOUNT_KEY)
    let _ = lookup(
        hasher,
        buf,
        proof: rlp::read_item(buf, at: 0),
        root: m::STATE_ROOT,
        key: key_buf.span(),
        key_offset: 0,
        key_len: 32,
    )
}

#[cfg(target = "native")]
#[test(should_revert)]
fn a_forged_root_is_refused() {
    // The first node no longer hashes to the root it is checked against.
    let hasher = SoftKeccak {}
    var proof_buf = m::account_proof()
    let buf = proof_buf.span()
    var key_buf = key_of(m::ACCOUNT_KEY)
    let _ = lookup(
        hasher,
        buf,
        proof: rlp::read_item(buf, at: 0),
        root: m::STATE_ROOT ^ 1,
        key: key_buf.span(),
        key_offset: 0,
        key_len: 32,
    )
}

#[cfg(target = "native")]
#[test(should_revert)]
fn another_account_s_proof_does_not_serve_this_key() {
    // A genuine, fully-hashing proof for a different key. It is refused rather
    // than reported absent, because the path it walks does not reach a node
    // that settles this key either way.
    let hasher = SoftKeccak {}
    var proof_buf = m::eoa_proof()
    let buf = proof_buf.span()
    var key_buf = key_of(m::ACCOUNT_KEY)
    let _ = lookup(
        hasher,
        buf,
        proof: rlp::read_item(buf, at: 0),
        root: m::STATE_ROOT,
        key: key_buf.span(),
        key_offset: 0,
        key_len: 32,
    )
}

// --- Receipts and events ----------------------------------------------------
//
// The other trie a block header commits to. VeriFe proves
// `ExecutionPayload.receipts_root` from a beacon root; these tests take it
// from there to an individual log.
//
// Two things differ from the state trie. The key is `rlp(index)` and is **not
// hashed**, so it is one or two bytes rather than 32 -- which is why `lookup`
// takes a key length. And the value is a typed envelope: for every receipt
// type but legacy, a one-byte type prefix in front of the RLP list.

#[cfg(target = "native")]
use ingot::fixture_receipts_mainnet as r

#[cfg(target = "native")]
#[test]
fn a_real_mainnet_receipt_is_proven_from_its_receipts_root() {
    let hasher = SoftKeccak {}
    var proof_buf = r::proof()
    let buf = proof_buf.span()
    var key_buf = r::key()

    let found = lookup(
        hasher,
        buf,
        proof: rlp::read_item(buf, at: 0),
        root: r::RECEIPTS_ROOT,
        key: key_buf.span(),
        key_offset: 0,
        key_len: r::KEY_LEN,
    )
    assert!(found.present, "transaction 48's receipt is in the trie")

    // A type-2 (EIP-1559) receipt: one prefix byte, then the four-item list.
    assert!(
        buf[found.value_at] == r::RECEIPT_TYPE,
        "the envelope type byte",
    )
    let receipt = rlp::read_item(buf, at: found.value_at + 1)
    assert!(receipt.is_list)
    assert!(
        rlp::count(buf, list: receipt) == 4,
        "status, gas, bloom, logs",
    )
    assert!(
        rlp::read_uint(buf, item: rlp::nth(buf, list: receipt, index: 0)) == r::RECEIPT_STATUS,
    )
    assert!(
        rlp::read_uint(buf, item: rlp::nth(buf, list: receipt, index: 1)) == r::CUMULATIVE_GAS_USED,
    )
    // The bloom is 256 bytes, always.
    assert!(rlp::nth(buf, list: receipt, index: 2).len == 256)

    let logs = rlp::nth(buf, list: receipt, index: 3)
    assert!(logs.is_list)
    assert!(rlp::count(buf, list: logs) == r::LOG_COUNT)
}

#[cfg(target = "native")]
#[test]
fn a_weth_transfer_event_is_proven_and_identified() {
    // The end of the line for an event proof: from a receipts root down to one
    // log's address, topics and data -- and then the log is *identified*, by
    // hashing the event signature here and requiring it to equal topic 0.
    // Nothing in this test takes the event's identity on trust from the
    // fixture.
    let hasher = SoftKeccak {}
    var proof_buf = r::proof()
    let buf = proof_buf.span()
    var key_buf = r::key()

    let found = lookup(
        hasher,
        buf,
        proof: rlp::read_item(buf, at: 0),
        root: r::RECEIPTS_ROOT,
        key: key_buf.span(),
        key_offset: 0,
        key_len: r::KEY_LEN,
    )
    assert!(found.present)
    let receipt = rlp::read_item(buf, at: found.value_at + 1)
    let logs = rlp::nth(buf, list: receipt, index: 3)

    // Log 1 is WETH's. A log is [address, topics, data].
    let log = rlp::nth(buf, list: logs, index: 1)
    assert!(rlp::count(buf, list: log) == 3)

    let address = rlp::nth(buf, list: log, index: 0)
    assert!(address.len == 20, "an address is 20 bytes")
    assert!(rlp::read_word(buf, item: address) == r::LOG_1_ADDRESS)

    let topics = rlp::nth(buf, list: log, index: 1)
    assert!(rlp::count(buf, list: topics) == r::LOG_1_TOPIC_COUNT)
    let topic0 = rlp::read_hash(buf, item: rlp::nth(buf, list: topics, index: 0))
    assert!(topic0 == r::LOG_1_TOPIC_0)

    // And this is what makes it a *Transfer*: topic 0 of an ERC-20 Transfer is
    // keccak256 of the event's signature, hashed right here rather than
    // copied from the fixture.
    var sig = MemBuffer::new(0)
    // "Transfer(address,address,uint256)" is 33 bytes: the closing paren is
    // part of it. Leaving it off produced a hash that matched nothing, which
    // is the right kind of failure for this test to have had.
    let text: [u8; 33] = [
        0x54,
        0x72,
        0x61,
        0x6e,
        0x73,
        0x66,
        0x65,
        0x72,
        0x28,
        0x61,
        0x64,
        0x64,
        0x72,
        0x65,
        0x73,
        0x73,
        0x2c,
        0x61,
        0x64,
        0x64,
        0x72,
        0x65,
        0x73,
        0x73,
        0x2c,
        0x75,
        0x69,
        0x6e,
        0x74,
        0x32,
        0x35,
        0x36,
        0x29,
    ]
    for byte in text {
        sig.push(byte)
    }
    assert!(
        hasher.keccak(sig.span()) == topic0,
        "topic 0 is keccak256(\"Transfer(address,address,uint256)\")",
    )

    // The indexed `from` and `to`, and 32 bytes of data for the amount.
    assert!(
        rlp::read_hash(buf, item: rlp::nth(buf, list: topics, index: 1)) == r::LOG_1_TOPIC_1,
    )
    assert!(
        rlp::read_hash(buf, item: rlp::nth(buf, list: topics, index: 2)) == r::LOG_1_TOPIC_2,
    )
    assert!(
        rlp::nth(buf, list: log, index: 2).len == r::LOG_1_DATA_LEN,
    )
}

#[cfg(target = "native")]
#[test(should_revert)]
fn a_receipt_proof_read_with_a_hashed_key_length_is_refused() {
    // The bug this very module had until a real receipt proof existed for it:
    // the receipts trie keys by `rlp(index)`, so reading its proof with a
    // 32-byte key walks a path that cannot be there.
    let hasher = SoftKeccak {}
    var proof_buf = r::proof()
    let buf = proof_buf.span()
    var key_buf = r::key()
    let _ = lookup(
        hasher,
        buf,
        proof: rlp::read_item(buf, at: 0),
        root: r::RECEIPTS_ROOT,
        key: key_buf.span(),
        key_offset: 0,
        key_len: 32,
    )
}

// --- Differential vectors ---------------------------------------------------
//
// The mainnet fixtures establish that this verifier agrees with the chain on a
// handful of real proofs. These establish that it agrees with an independent
// trie builder across trie *shapes* -- which is the part a few real proofs
// cannot cover, because a real account proof is one shape.

#[cfg(target = "native")]
use ingot::fixture_trie_vectors as vectors

#[cfg(target = "native")]
#[test]
fn every_random_trie_vector_agrees_with_the_independent_builder() {
    let hasher = SoftKeccak {}
    var blob = vectors::vectors()
    let buf = blob.span()

    let count = (buf[0] as usize) * 256 + buf[1] as usize
    assert!(count == vectors::COUNT, "the packed vector count")

    var at: usize = 2
    var present_seen: usize = 0
    var absent_seen: usize = 0
    var index: usize = 0

    while index < count {
        let present = buf[at] == 1
        at += 1
        let root = word_at(buf, at)
        at += 32
        let key_at = at
        at += 32
        let value_len = (buf[at] as usize) * 256 + buf[at + 1] as usize
        at += 2
        let proof_len = (buf[at] as usize) * 256 + buf[at + 1] as usize
        at += 2
        let value_at = at
        at += value_len
        let proof_at = at
        at += proof_len

        let found = lookup(
            hasher,
            buf,
            proof: rlp::read_item(buf, at: proof_at),
            root,
            key: buf,
            key_offset: key_at,
            key_len: 32,
        )

        assert!(
            found.present == present,
            "presence disagrees with the builder",
        )
        if present {
            present_seen += 1
            // `value_at` and `value_len` are the raw value bytes, compared
            // directly. Not through `rlp::read_item`: that is right for
            // Ethereum's tries, whose values happen to be RLP -- an account
            // is a list, a storage slot an integer, a receipt a typed
            // envelope -- but these values are random bytes, and reading an
            // RLP item out of them misparses the first byte as a header. The
            // first version of this test did exactly that and failed with
            // "value length disagrees": the vectors earning their place, since
            // no mainnet fixture could have caught it.
            assert!(found.value_len == value_len, "value length disagrees")
            var k: usize = 0
            while k < value_len {
                assert!(
                    buf[found.value_at + k] == buf[value_at + k],
                    "value bytes disagree",
                )
                k += 1
            }
        } else {
            absent_seen += 1
        }
        index += 1
    }

    assert!(at == buf.len(), "the blob was not walked exactly")
    assert!(present_seen == vectors::PRESENT)
    assert!(absent_seen == vectors::ABSENT)
}

/// A 32-byte big-endian word at `offset`.
#[cfg(target = "native")]
fn word_at(_ buf: MemSpan, _ offset: usize) -> u256 {
    var value: u256 = 0
    var index: usize = 0
    while index < 32 {
        value = (value << 8) | (buf[offset + index] as u256)
        index += 1
    }
    value
}
