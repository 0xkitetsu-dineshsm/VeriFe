//! Canonical RLP, read in place.
//!
//! RLP is the execution layer's encoding, and it is where VeriFe meets the
//! Merkle-Patricia tries that commit to account and receipt data. Everything
//! else in this library is SSZ: fixed arity, SHA-256, positions derived from a
//! type. RLP is the opposite -- variable length, Keccak-256, and a format with
//! several ways to write the same value. So this module's whole job is to
//! accept exactly one of them.
//!
//! ## Why canonicality is a security property, not tidiness
//!
//! A trie node is addressed by the Keccak hash of its bytes. If two different
//! byte strings decoded to the same value, a prover could choose whichever one
//! hashed to the reference they needed. Rejecting non-canonical encodings is
//! what makes "the node hashes to its parent's reference" mean "the node *is*
//! what the parent committed to". The four rules enforced here:
//!
//!   1. a byte below 0x80 is itself, and must not be written as `0x81 xx`;
//!   2. the long form (`0xb8`/`0xf8` and up) is only for payloads over 55
//!      bytes, so a short payload cannot be written the long way;
//!   3. a length written in several bytes must not have a leading zero;
//!   4. an integer must not have a leading zero byte -- which is why zero is
//!      the *empty* string and not `0x00`.
//!
//! Rule 4 is the one that surprises people, and the real mainnet account in
//! the tests below has `balance = 0x` for exactly that reason.
//!
//! Nothing is copied. An `Item` is an offset and a length into the caller's
//! buffer, so a proof is walked where it lies.

use core::ptr::MemSpan

/// One RLP item: where its payload starts, how long it is, and whether it is
/// a list.
///
/// `header_len` is kept so that a caller can step over the whole item without
/// re-reading its first byte.
pub struct Item { pub offset: usize, pub len: usize, pub is_list: bool, pub header_len: usize }

impl Item {
    /// The offset just past this item, i.e. where the next sibling begins.
    pub fn end(self) -> usize {
        self.offset + self.len
    }

    /// Where this item's own bytes begin, header included. Needed when the
    /// item has to be hashed, because a node is addressed by the hash of its
    /// full encoding and not of its payload.
    pub fn start(self) -> usize {
        self.offset - self.header_len
    }

    /// The whole encoded item, header included.
    pub fn total_len(self) -> usize {
        self.header_len + self.len
    }
}

/// Read the item that begins at `at`.
///
/// Reverts on any encoding this format does not require, per the module note.
pub fn read_item(_ buf: MemSpan, at: usize) -> Item {
    assert!(at < buf.len(), "rlp: read past the end of the buffer")
    let prefix = buf[at]

    if prefix < 0x80 {
        // A single byte below 0x80 is its own encoding; the payload *is* the
        // prefix byte, so the item starts where the prefix is.
        return Item { offset: at, len: 1, is_list: false, header_len: 0 }
    }

    if prefix <= 0xb7 {
        let len = (prefix - 0x80) as usize
        assert!(at + 1 + len <= buf.len(), "rlp: string runs past the end")
        if len == 1 {
            // Rule 1.
            assert!(
                buf[at + 1] >= 0x80,
                "rlp: single byte below 0x80 written the long way",
            )
        }
        return Item { offset: at + 1, len, is_list: false, header_len: 1 }
    }

    if prefix <= 0xbf {
        let len_len = (prefix - 0xb7) as usize
        let len = read_length(buf, at: at + 1, len_len)
        // Rule 2.
        assert!(len > 55, "rlp: short string written in the long form")
        assert!(
            at + 1 + len_len + len <= buf.len(),
            "rlp: string runs past the end",
        )
        return Item { offset: at + 1 + len_len, len, is_list: false, header_len: 1 + len_len }
    }

    if prefix <= 0xf7 {
        let len = (prefix - 0xc0) as usize
        assert!(at + 1 + len <= buf.len(), "rlp: list runs past the end")
        return Item { offset: at + 1, len, is_list: true, header_len: 1 }
    }

    let len_len = (prefix - 0xf7) as usize
    let len = read_length(buf, at: at + 1, len_len)
    // Rule 2, for lists.
    assert!(len > 55, "rlp: short list written in the long form")
    assert!(
        at + 1 + len_len + len <= buf.len(),
        "rlp: list runs past the end",
    )
    Item { offset: at + 1 + len_len, len, is_list: true, header_len: 1 + len_len }
}

/// A big-endian length of `len_len` bytes, with no leading zero (rule 3).
///
/// Bounded at four bytes: a length that needs five would describe a buffer no
/// proof can carry, and leaving it unbounded is how a length overflows into
/// something small. `@ethereumjs/trie` accepts those; this does not.
fn read_length(_ buf: MemSpan, at: usize, len_len: usize) -> usize {
    assert!(
        len_len >= 1 && len_len <= 4,
        "rlp: length does not fit four bytes",
    )
    assert!(at + len_len <= buf.len(), "rlp: length runs past the end")
    assert!(buf[at] != 0, "rlp: length has a leading zero byte")
    var len: usize = 0
    var index: usize = 0
    while index < len_len {
        len = len * 256 + buf[at + index] as usize
        index += 1
    }
    len
}

/// The first item inside `list`.
pub fn first(_ buf: MemSpan, list: Item) -> Item {
    assert!(list.is_list, "rlp: not a list")
    assert!(list.len > 0, "rlp: the list is empty")
    read_item(buf, at: list.offset)
}

/// The item after `item`, which must still be inside `list`.
pub fn next(_ buf: MemSpan, list: Item, item: Item) -> Item {
    let at = item.end()
    assert!(at < list.end(), "rlp: no further item in this list")
    read_item(buf, at)
}

/// How many items `list` holds.
pub fn count(_ buf: MemSpan, list: Item) -> usize {
    assert!(list.is_list, "rlp: not a list")
    var at = list.offset
    var n: usize = 0
    while at < list.end() {
        let item = read_item(buf, at)
        at = item.end()
        n += 1
    }
    assert!(at == list.end(), "rlp: the last item overruns the list")
    n
}

/// Item `index` of `list`.
pub fn nth(_ buf: MemSpan, list: Item, index: usize) -> Item {
    assert!(list.is_list, "rlp: not a list")
    var at = list.offset
    var i: usize = 0
    while true {
        assert!(at < list.end(), "rlp: the list has no item at that index")
        let item = read_item(buf, at)
        if i == index { return item }
        at = item.end()
        i += 1
    }
    // Unreachable: the loop either returns or asserts.
    read_item(buf, at: list.offset)
}

/// A string item as a big-endian integer, rejecting a leading zero (rule 4).
///
/// The empty string is zero, which is what makes `balance = 0x` canonical.
pub fn read_uint(_ buf: MemSpan, item: Item) -> u256 {
    assert!(!item.is_list, "rlp: a list is not an integer")
    assert!(item.len <= 32, "rlp: integer wider than 32 bytes")
    if item.len == 0 { return 0 }
    assert!(
        buf[item.offset] != 0,
        "rlp: integer has a leading zero byte",
    )
    var value: u256 = 0
    var index: usize = 0
    while index < item.len {
        value = (value << 8) | (buf[item.offset + index] as u256)
        index += 1
    }
    value
}

/// A 32-byte string item as a word: a hash or a trie reference.
///
/// Distinct from `read_uint` because a hash with a leading zero byte is
/// perfectly ordinary, and must not be rejected by rule 4.
pub fn read_hash(_ buf: MemSpan, item: Item) -> u256 {
    assert!(!item.is_list, "rlp: a list is not a hash")
    assert!(item.len == 32, "rlp: a hash is 32 bytes")
    var value: u256 = 0
    var index: usize = 0
    while index < 32 {
        value = (value << 8) | (buf[item.offset + index] as u256)
        index += 1
    }
    value
}

/// A byte string of up to 32 bytes as a right-aligned word, with no
/// canonicality rule applied.
///
/// Distinct from `read_uint`, which rejects a leading zero because an RLP
/// integer must not have one, and from `read_hash`, which insists on exactly
/// 32. This is for fixed-width byte strings that are not integers: a 20-byte
/// log address beginning `0x00...` is perfectly ordinary and must not be
/// refused, and must not be read as if the zero had been stripped.
pub fn read_word(_ buf: MemSpan, item: Item) -> u256 {
    assert!(!item.is_list, "rlp: a list is not a word")
    assert!(item.len <= 32, "rlp: byte string wider than a word")
    var value: u256 = 0
    var index: usize = 0
    while index < item.len {
        value = (value << 8) | (buf[item.offset + index] as u256)
        index += 1
    }
    value
}

// --- Tests ------------------------------------------------------------------
//
// The vector is a real mainnet account: USDC's, from `eth_getProof` at block
// 26,472,617. Its four decoded fields are checked against what the node
// reported for the same account, so this is a differential test against
// geth's own encoder rather than against our understanding of the format.

use core::ptr::MemBuffer

/// USDC's account, RLP-encoded, exactly as it appears as the value of the
/// final node of its `accountProof`.
fn usdc_account() -> MemBuffer {
    let bytes: [u8; 70] = [
        0xf8,
        0x44,
        0x01,
        0x80,
        0xa0,
        0x11,
        0xb4,
        0xa0,
        0xbd,
        0xea,
        0x77,
        0x2c,
        0xa7,
        0x22,
        0xfc,
        0xca,
        0x21,
        0xdd,
        0x25,
        0x3a,
        0xb3,
        0x15,
        0x03,
        0xb4,
        0xde,
        0x25,
        0x26,
        0x12,
        0x39,
        0x4b,
        0x86,
        0x5d,
        0x7c,
        0xe9,
        0xf2,
        0x17,
        0x05,
        0xa0,
        0xd8,
        0x0d,
        0x4b,
        0x7c,
        0x89,
        0x0c,
        0xb9,
        0xd6,
        0xa4,
        0x89,
        0x3e,
        0x6b,
        0x52,
        0xbc,
        0x34,
        0xb5,
        0x6b,
        0x25,
        0x33,
        0x5c,
        0xb1,
        0x37,
        0x16,
        0xe0,
        0xd1,
        0xd3,
        0x13,
        0x83,
        0xe6,
        0xb4,
        0x15,
        0x05,
    ]
    var buf = MemBuffer::new(0)
    for byte in bytes {
        buf.push(byte)
    }
    buf
}

#[test]
fn a_real_mainnet_account_decodes() {
    let buf = usdc_account()
    let span = buf.span()
    let account = read_item(span, at: 0)
    assert!(account.is_list, "an account is a list of four")
    assert!(count(span, list: account) == 4)

    // nonce 1, and a balance of zero written as the empty string.
    assert!(
        read_uint(span, item: nth(span, list: account, index: 0)) == 1,
    )
    let balance_item = nth(span, list: account, index: 1)
    assert!(
        balance_item.len == 0,
        "zero is the empty string, not 0x00",
    )
    assert!(read_uint(span, item: balance_item) == 0)

    // The two hashes the RPC reported for this account.
    assert!(
        read_hash(span, item: nth(span, list: account, index: 2))
            == 0x11b4a0bdea772ca722fcca21dd253ab31503b4de252612394b865d7ce9f21705,
    )
    assert!(
        read_hash(span, item: nth(span, list: account, index: 3))
            == 0xd80d4b7c890cb9d6a4893e6b52bc34b56b25335cb13716e0d1d31383e6b41505,
    )
}

#[test]
fn the_long_form_header_is_measured_not_assumed() {
    let buf = usdc_account()
    let span = buf.span()
    let account = read_item(span, at: 0)
    // 0xf8 0x44: a long-form list with a one-byte length of 68.
    assert!(account.header_len == 2)
    assert!(account.len == 68)
    assert!(account.start() == 0)
    assert!(account.total_len() == 70)
    assert!(account.total_len() == buf.len())
}

#[test]
fn walking_the_items_and_indexing_them_agree() {
    let buf = usdc_account()
    let span = buf.span()
    let account = read_item(span, at: 0)
    var item = first(span, list: account)
    var index: usize = 0
    while index < 3 {
        item = next(span, list: account, item)
        index += 1
    }
    assert!(item.offset == nth(span, list: account, index: 3).offset)
    assert!(item.len == 32)
}

#[test(should_revert)]
fn a_single_byte_written_the_long_way_is_refused() {
    // Rule 1: 0x81 0x7f re-encodes 0x7f, which is its own encoding.
    var buf = MemBuffer::new(0)
    buf.push(0x81)
    buf.push(0x7f)
    let _ = read_item(buf.span(), at: 0)
}

#[test(should_revert)]
fn a_short_string_written_in_the_long_form_is_refused() {
    // Rule 2: 0xb8 0x01 0xff says "a one-byte string, the long way".
    var buf = MemBuffer::new(0)
    buf.push(0xb8)
    buf.push(0x01)
    buf.push(0xff)
    let _ = read_item(buf.span(), at: 0)
}

#[test(should_revert)]
fn a_length_with_a_leading_zero_is_refused() {
    // Rule 3: 0xb9 0x00 0x38 is a two-byte length of 56.
    var buf = MemBuffer::new(0)
    buf.push(0xb9)
    buf.push(0x00)
    buf.push(0x38)
    let _ = read_item(buf.span(), at: 0)
}

#[test(should_revert)]
fn an_integer_with_a_leading_zero_is_refused() {
    // Rule 4: 0x82 0x00 0x01 encodes 1 with a padding byte.
    var buf = MemBuffer::new(0)
    buf.push(0x82)
    buf.push(0x00)
    buf.push(0x01)
    let span = buf.span()
    let _ = read_uint(span, item: read_item(span, at: 0))
}

#[test(should_revert)]
fn a_length_too_wide_to_be_real_is_refused() {
    // Five length bytes. `@ethereumjs/trie` accepts these; a length that
    // cannot describe any real buffer has no business being decoded.
    var buf = MemBuffer::new(0)
    buf.push(0xbc)
    var i: usize = 0
    while i < 5 {
        buf.push(0xff)
        i += 1
    }
    let _ = read_item(buf.span(), at: 0)
}

#[test(should_revert)]
fn an_item_running_past_the_buffer_is_refused() {
    var buf = MemBuffer::new(0)
    buf.push(0x85)
    buf.push(0x01)
    let _ = read_item(buf.span(), at: 0)
}
