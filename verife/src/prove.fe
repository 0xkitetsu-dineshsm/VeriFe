//! The whole chain of commitments, in one call, generic over where the anchor
//! root comes from.
//!
//! `verify.fe` holds the legs: the anchor header, the fork version, the target
//! root, the target header, the payload field. This module composes them into
//! the thing a caller actually wants -- "prove `block_hash` of slot `s`" -- and
//! takes the anchor source as a type parameter rather than calling EIP-4788
//! itself.
//!
//! That parameter is why this module exists. Without it the composed path
//! would have to live in `contract/`, where `fe test` cannot reach it: the test
//! EVM has no beacon-roots contract at
//! `0x000F3df6D732807Ef1319fB7B8bB8522d0Beac02` and cannot send a call from the
//! system address, so a contract that called EIP-4788 directly could only be
//! compiled, never run. Here the same code runs three ways:
//!
//!   * in `fe test`, with `FixedAnchor` and `SoftSha256`;
//!   * in the CLI, with `FixedAnchor` and `SoftSha256`, natively;
//!   * on chain, with `Eip4788` and `PrecompileSha256`.
//!
//! `uses S::E` is what makes that possible: the effect row comes from the
//! anchor source, so the EVM `Call` effect is present exactly when the source
//! is the one that needs it, and the native build never mentions it.
//!
//! The four type parameters are load-bearing, not ceremony:
//!
//! | Parameter | What it fixes |
//! | --- | --- |
//! | `A` | the **anchor's** fork layout: gindices and depths in the anchor state |
//! | `T` | the **target's** fork layout: the shape of its execution payload |
//! | `H` | the hasher: precompile on chain, software natively |
//! | `S` | the anchor source, and with it the effects this call needs |
//!
//! `A` and `T` are separate because a proof routinely spans forks: the
//! historical fixture reads a Fulu anchor to reach a Capella block, 3.3 years
//! and four forks earlier. One `Fork` parameter could not express that, and a
//! runtime fork tag -- the Solidity approach -- is what this project is arguing
//! against.

use ingot::anchor::AnchorSource
use ingot::dispatch::{require_anchor_not_before_target, require_target_layout}
use ingot::hash::ChunkHasher
use ingot::header::BeaconBlockHeader
use ingot::layout::{
    period_proof_len,
    ForkLayout,
    ForkVersionProof,
    HistoricalProof,
    PayloadProof,
    RecentProof,
}
use ingot::verify::{
    payload_root_field,
    payload_uint64_field,
    require_fork_version,
    verify_historical,
    verify_in_period,
    verify_recent,
    ProvenHistorical,
    ProvenTarget,
}

/// Steps 1, 2, 8, 4 and 5 of the recent path: everything up to a proven target
/// header.
///
/// Split out from the field proofs because one proven target serves any number
/// of fields: the CLI proves five from a single call to this, and a caller on
/// chain that wants two fields pays for the state-side branch once.
pub fn prove_recent_target<A: ForkLayout, H: ChunkHasher, S: AnchorSource>(
    source: S,
    hasher: H,
    anchor_timestamp: u64,
    anchor_header: BeaconBlockHeader,
    fork_proof: ForkVersionProof<A>,
    target_slot: u64,
    target_header: BeaconBlockHeader,
    proof: RecentProof<A>,
) -> ProvenTarget
uses S::E
{
    // Step 1. The only trusted input in the whole call.
    let anchor_root = source.root_at(timestamp: anchor_timestamp)

    // Invariant 8, before the anchor's `state_root` is used for anything: the
    // chain must agree that the anchor is the fork `A` describes. The header is
    // not yet proven here, so this is checked again inside `verify_recent`
    // against the anchor root -- a forged header with a matching fork proof
    // still fails there.
    require_fork_version<A, _>(
        hasher,
        state_root: anchor_header.state_root,
        proof: fork_proof,
    )

    // Steps 2, 4 and 5.
    verify_recent<A, _>(
        hasher,
        anchor_root,
        anchor_header,
        target_slot,
        target_header,
        proof,
    )
}

/// The same, by the historical path, for a target older than the anchor's
/// 8,192-slot window.
pub fn prove_historical_target<A: ForkLayout, H: ChunkHasher, S: AnchorSource>(
    source: S,
    hasher: H,
    anchor_timestamp: u64,
    anchor_header: BeaconBlockHeader,
    fork_proof: ForkVersionProof<A>,
    target_slot: u64,
    target_header: BeaconBlockHeader,
    proof: HistoricalProof<A>,
) -> ProvenHistorical
uses S::E
{
    let anchor_root = source.root_at(timestamp: anchor_timestamp)

    require_fork_version<A, _>(
        hasher,
        state_root: anchor_header.state_root,
        proof: fork_proof,
    )

    verify_historical<A, _>(
        hasher,
        anchor_root,
        anchor_header,
        target_slot,
        target_header,
        proof,
    )
}

/// A 32-byte `ExecutionPayload` field of a recent block, end to end: all six
/// steps in one call.
///
/// `T` is the *target's* layout, which is what sizes `PayloadProof<T>` and
/// places the field. For a target inside the anchor's window `T` is usually
/// `A`, but it need not be: the window can straddle a fork boundary, and then
/// the anchor is the new fork and an early target in the window is the old one.
pub fn prove_recent_payload_root<A: ForkLayout, T: ForkLayout, H: ChunkHasher, S: AnchorSource>(
    source: S,
    hasher: H,
    anchor_timestamp: u64,
    anchor_header: BeaconBlockHeader,
    fork_proof: ForkVersionProof<A>,
    target_slot: u64,
    target_header: BeaconBlockHeader,
    proof: RecentProof<A>,
    field: u64,
    value: u256,
    payload_proof: PayloadProof<T>,
) -> u256
uses S::E
{
    let target = prove_recent_target<A, _, _>(
        source,
        hasher,
        anchor_timestamp,
        anchor_header,
        fork_proof,
        target_slot,
        target_header,
        proof,
    )

    // Invariant 7, on a slot that is now a fact rather than a claim.
    require_target_layout<T>(target)
    require_anchor_not_before_target<A>(target)

    payload_root_field<T, _>(hasher, target, field, value, proof: payload_proof)
}

/// A `uint64` `ExecutionPayload` field of a recent block -- `block_number`,
/// `timestamp` -- end to end. The leaf is little-endian (invariant 11).
pub fn prove_recent_payload_uint64<A: ForkLayout, T: ForkLayout, H: ChunkHasher, S: AnchorSource>(
    source: S,
    hasher: H,
    anchor_timestamp: u64,
    anchor_header: BeaconBlockHeader,
    fork_proof: ForkVersionProof<A>,
    target_slot: u64,
    target_header: BeaconBlockHeader,
    proof: RecentProof<A>,
    field: u64,
    value: u64,
    payload_proof: PayloadProof<T>,
) -> u64
uses S::E
{
    let target = prove_recent_target<A, _, _>(
        source,
        hasher,
        anchor_timestamp,
        anchor_header,
        fork_proof,
        target_slot,
        target_header,
        proof,
    )

    require_target_layout<T>(target)
    require_anchor_not_before_target<A>(target)

    payload_uint64_field<T, _>(hasher, target, field, value, proof: payload_proof)
}

/// What a historical proof gives a verifier that keeps what it proves: the
/// field value, and the period commitment worth storing.
///
/// The commitment is returned beside the value because every on-chain caller
/// of the historical path wants both, and because a caller that discards it
/// has thrown away the thing that keeps working after the next fork.
pub struct HistoricalProven {
    /// The proven field value.
    pub value: u256,
    /// The period's `block_summary_root`. Permanently valid: see
    /// `verify_in_period`.
    pub summary_root: u256,
    /// Which `historical_summaries` element it was, derived from the slot.
    pub summary_index: u64,
}

/// A 32-byte `ExecutionPayload` field of *any* post-Capella block, through
/// `historical_summaries`.
///
/// This is the signature the whole project is for. `A` and `T` are two
/// different forks whenever the target is old, and every proof length in the
/// call is derived from one of them.
pub fn prove_historical_payload_root<A: ForkLayout, T: ForkLayout, H: ChunkHasher, S: AnchorSource>(
    source: S,
    hasher: H,
    anchor_timestamp: u64,
    anchor_header: BeaconBlockHeader,
    fork_proof: ForkVersionProof<A>,
    target_slot: u64,
    target_header: BeaconBlockHeader,
    proof: HistoricalProof<A>,
    field: u64,
    value: u256,
    payload_proof: PayloadProof<T>,
) -> HistoricalProven
uses S::E
{
    let proven = prove_historical_target<A, _, _>(
        source,
        hasher,
        anchor_timestamp,
        anchor_header,
        fork_proof,
        target_slot,
        target_header,
        proof,
    )
    require_target_layout<T>(target: proven.target)
    require_anchor_not_before_target<A>(target: proven.target)

    HistoricalProven {
        value: payload_root_field<T, _>(
            hasher,
            target: proven.target,
            field,
            value,
            proof: payload_proof,
        ),
        summary_root: proven.summary_root,
        summary_index: proven.summary_index,
    }
}

// --- The cached path --------------------------------------------------------
//
// Everything above begins with `source.root_at(...)`: an anchor, and therefore
// the fork that is live right now. Everything below begins with a
// `block_summary_root` that was proven out of an anchor state at some earlier
// time and kept.
//
// That is sound because `historical_summaries` only ever grows and the periods
// already in it never change. A `block_summary_root` commits to 8,192
// finalized block roots; proving one is a statement about finalized history,
// and finalized history does not acquire a new meaning at the next fork.
//
// The consequence is the one worth having: these functions have no
// `A: ForkLayout` and no `S: AnchorSource`, so they carry no effect row and
// cannot name the live fork even by accident. A verifier that stores what it
// proves goes on answering questions about every block up to the moment it
// last cached, through a fork nobody has specified yet, with no redeployment
// and no new trust.
//
// What they cannot do is reach *forward*. A block mined after the fork needs
// that fork's payload layout, and no code deployed today can know it.

/// A 32-byte `ExecutionPayload` field of a block in a period whose
/// `block_summary_root` is already known.
///
/// `summary_root` must be a commitment this library proved earlier --
/// `verify_historical`'s `summary_root`, kept in storage -- and never a value
/// from calldata. `T` is the target's layout, as always.
pub fn prove_cached_payload_root<T: ForkLayout, H: ChunkHasher>(
    hasher: H,
    summary_root: u256,
    target_slot: u64,
    target_header: BeaconBlockHeader,
    period_branch: [u256; period_proof_len()],
    field: u64,
    value: u256,
    payload_proof: PayloadProof<T>,
) -> u256 {
    let target = verify_in_period(
        hasher,
        summary_root,
        target_slot,
        target_header,
        period_branch,
    )

    // Invariant 7's first half only. There is no anchor here and so no anchor
    // fork to compare against -- which is the point of the cached path, and
    // also why the target's own layout still has to be checked.
    require_target_layout<T>(target)

    payload_root_field<T, _>(hasher, target, field, value, proof: payload_proof)
}

/// The same for a `uint64` field -- `block_number`, `timestamp` -- whose leaf
/// is little-endian (invariant 11).
pub fn prove_cached_payload_uint64<T: ForkLayout, H: ChunkHasher>(
    hasher: H,
    summary_root: u256,
    target_slot: u64,
    target_header: BeaconBlockHeader,
    period_branch: [u256; period_proof_len()],
    field: u64,
    value: u64,
    payload_proof: PayloadProof<T>,
) -> u64 {
    let target = verify_in_period(
        hasher,
        summary_root,
        target_slot,
        target_header,
        period_branch,
    )

    require_target_layout<T>(target)

    payload_uint64_field<T, _>(hasher, target, field, value, proof: payload_proof)
}

// --- Tests ------------------------------------------------------------------
//
// These run the *composed* path -- the one the contract's entry points run --
// over the real mainnet fixtures, with `FixedAnchor` standing in for the
// EIP-4788 call. That substitution is the whole point of `AnchorSource`: the
// code under test here is byte for byte the code the deployed verifier runs,
// with one type parameter bound differently.

use ingot::anchor::FixedAnchor
use ingot::fixture_historical_capella as historical
use ingot::fixture_missed_slot_fulu as missed
use ingot::fixture_recent_fulu as recent
use ingot::hash::SoftSha256
use ingot::layout::{
    Capella,
    Electra,
    Fulu,
    PAYLOAD_BLOCK_HASH_FIELD,
    PAYLOAD_BLOCK_NUMBER_FIELD,
    PAYLOAD_STATE_ROOT_FIELD,
}

fn recent_anchor() -> FixedAnchor {
    FixedAnchor { timestamp: recent::ANCHOR_TIMESTAMP, root: recent::ANCHOR_ROOT }
}

#[test]
fn the_composed_recent_path_proves_a_block_hash() {
    let proven = prove_recent_payload_root<Fulu, Fulu, _, _>(
        source: recent_anchor(),
        hasher: SoftSha256 {},
        anchor_timestamp: recent::ANCHOR_TIMESTAMP,
        anchor_header: recent::anchor_header(),
        fork_proof: recent::fork_version_proof(),
        target_slot: recent::TARGET_SLOT,
        target_header: recent::target_header(),
        proof: recent::recent_proof(),
        field: PAYLOAD_BLOCK_HASH_FIELD,
        value: recent::PAYLOAD_BLOCK_HASH,
        payload_proof: recent::block_hash_proof(),
    )
    assert!(proven == recent::PAYLOAD_BLOCK_HASH)
}

#[test]
fn the_composed_recent_path_proves_a_little_endian_block_number() {
    let proven = prove_recent_payload_uint64<Fulu, Fulu, _, _>(
        source: recent_anchor(),
        hasher: SoftSha256 {},
        anchor_timestamp: recent::ANCHOR_TIMESTAMP,
        anchor_header: recent::anchor_header(),
        fork_proof: recent::fork_version_proof(),
        target_slot: recent::TARGET_SLOT,
        target_header: recent::target_header(),
        proof: recent::recent_proof(),
        field: PAYLOAD_BLOCK_NUMBER_FIELD,
        value: recent::PAYLOAD_BLOCK_NUMBER,
        payload_proof: recent::block_number_proof(),
    )
    assert!(proven == recent::PAYLOAD_BLOCK_NUMBER)
}

#[test]
fn the_composed_historical_path_crosses_four_forks() {
    // A Fulu anchor and a Capella target: `A = Fulu` for every state-side
    // branch, `T = Capella` for the payload. Capella's payload has 15 fields
    // and Fulu's 17, so `PayloadProof<Capella>` is 8 levels where
    // `PayloadProof<Fulu>` is 9 -- and passing the wrong one does not compile,
    // which is `compile_fail/wrong_proof_length`.
    let proven = prove_historical_payload_root<Fulu, Capella, _, _>(
        source: FixedAnchor { timestamp: recent::ANCHOR_TIMESTAMP, root: historical::ANCHOR_ROOT },
        hasher: SoftSha256 {},
        anchor_timestamp: recent::ANCHOR_TIMESTAMP,
        anchor_header: historical::anchor_header(),
        fork_proof: recent::fork_version_proof(),
        target_slot: historical::TARGET_SLOT,
        target_header: historical::target_header(),
        proof: historical::historical_proof(),
        field: PAYLOAD_STATE_ROOT_FIELD,
        value: historical::PAYLOAD_STATE_ROOT,
        payload_proof: historical::state_root_proof(),
    )
    assert!(proven.value == historical::PAYLOAD_STATE_ROOT)
    // The commitment the caller is meant to keep.
    assert!(proven.summary_root == historical::BLOCK_SUMMARY_ROOT)
    assert!(proven.summary_index == historical::SUMMARY_INDEX)
}

#[test(should_revert)]
fn the_composed_path_rejects_the_missed_slot_attack() {
    // The same attack `verify.fe` tests, run through the composed entry point,
    // because that is what is deployed. A guard that holds in the leg and is
    // bypassed by the composition would be worth nothing.
    let _ = prove_recent_payload_root<Fulu, Fulu, _, _>(
        source: FixedAnchor { timestamp: recent::ANCHOR_TIMESTAMP, root: missed::ANCHOR_ROOT },
        hasher: SoftSha256 {},
        anchor_timestamp: recent::ANCHOR_TIMESTAMP,
        anchor_header: missed::anchor_header(),
        fork_proof: recent::fork_version_proof(),
        target_slot: missed::CLAIMED_SLOT,
        target_header: missed::repeated_header(),
        proof: missed::recent_proof(),
        field: PAYLOAD_BLOCK_HASH_FIELD,
        value: 0,
        payload_proof: recent::block_hash_proof(),
    )
}

#[test(should_revert)]
fn the_composed_path_refuses_an_anchor_from_another_timestamp() {
    // Invariant 1 through the composition: the source is asked for a root at a
    // timestamp it does not hold, and must revert rather than serve the only
    // root it has.
    let _ = prove_recent_payload_root<Fulu, Fulu, _, _>(
        source: recent_anchor(),
        hasher: SoftSha256 {},
        anchor_timestamp: recent::ANCHOR_TIMESTAMP + 12,
        anchor_header: recent::anchor_header(),
        fork_proof: recent::fork_version_proof(),
        target_slot: recent::TARGET_SLOT,
        target_header: recent::target_header(),
        proof: recent::recent_proof(),
        field: PAYLOAD_BLOCK_HASH_FIELD,
        value: recent::PAYLOAD_BLOCK_HASH,
        payload_proof: recent::block_hash_proof(),
    )
}

#[cfg(target = "evm")]
use ingot::hash::PrecompileSha256

#[cfg(target = "evm")]
#[test]
fn the_composed_path_agrees_through_the_precompile() {
    // The differential claim, in the composed path: the same call, the same
    // fixture, the two hashers, one answer.
    let soft = prove_recent_payload_root<Fulu, Fulu, _, _>(
        source: recent_anchor(),
        hasher: SoftSha256 {},
        anchor_timestamp: recent::ANCHOR_TIMESTAMP,
        anchor_header: recent::anchor_header(),
        fork_proof: recent::fork_version_proof(),
        target_slot: recent::TARGET_SLOT,
        target_header: recent::target_header(),
        proof: recent::recent_proof(),
        field: PAYLOAD_BLOCK_HASH_FIELD,
        value: recent::PAYLOAD_BLOCK_HASH,
        payload_proof: recent::block_hash_proof(),
    )
    let fast = prove_recent_payload_root<Fulu, Fulu, _, _>(
        source: recent_anchor(),
        hasher: PrecompileSha256 {},
        anchor_timestamp: recent::ANCHOR_TIMESTAMP,
        anchor_header: recent::anchor_header(),
        fork_proof: recent::fork_version_proof(),
        target_slot: recent::TARGET_SLOT,
        target_header: recent::target_header(),
        proof: recent::recent_proof(),
        field: PAYLOAD_BLOCK_HASH_FIELD,
        value: recent::PAYLOAD_BLOCK_HASH,
        payload_proof: recent::block_hash_proof(),
    )
    assert!(soft == fast)
    assert!(soft == recent::PAYLOAD_BLOCK_HASH)
}

// --- The cached path, over the same fixture ---------------------------------
//
// `historical::BLOCK_SUMMARY_ROOT` is period 758's `block_summary_root`, and
// `fixture_check.py` re-derives it from the raw SSZ. These tests never take it
// from the fixture: they take it from what `prove_historical_target` proved,
// which is exactly what a contract would have put in storage.

#[test]
fn the_cached_path_agrees_with_the_historical_path() {
    let hasher = SoftSha256 {}

    // Once, with an anchor. This is the call whose result gets stored.
    let proven = prove_historical_target<Fulu, _, _>(
        source: FixedAnchor { timestamp: recent::ANCHOR_TIMESTAMP, root: historical::ANCHOR_ROOT },
        hasher,
        anchor_timestamp: recent::ANCHOR_TIMESTAMP,
        anchor_header: historical::anchor_header(),
        fork_proof: recent::fork_version_proof(),
        target_slot: historical::TARGET_SLOT,
        target_header: historical::target_header(),
        proof: historical::historical_proof(),
    )
    assert!(proven.summary_root == historical::BLOCK_SUMMARY_ROOT)
    assert!(proven.summary_index == historical::SUMMARY_INDEX)

    // And now for ever, without one. No anchor timestamp, no fork proof, no
    // `A` parameter, no effect row: nothing in this call mentions the fork
    // that happens to be live.
    let value = prove_cached_payload_root<Capella, _>(
        hasher,
        summary_root: proven.summary_root,
        target_slot: historical::TARGET_SLOT,
        target_header: historical::target_header(),
        period_branch: historical::historical_proof().period_branch,
        field: PAYLOAD_BLOCK_HASH_FIELD,
        value: historical::PAYLOAD_BLOCK_HASH,
        payload_proof: historical::block_hash_proof(),
    )
    assert!(value == historical::PAYLOAD_BLOCK_HASH)
}

#[test]
fn the_cached_path_proves_a_little_endian_block_number() {
    let value = prove_cached_payload_uint64<Capella, _>(
        hasher: SoftSha256 {},
        summary_root: historical::BLOCK_SUMMARY_ROOT,
        target_slot: historical::TARGET_SLOT,
        target_header: historical::target_header(),
        period_branch: historical::historical_proof().period_branch,
        field: PAYLOAD_BLOCK_NUMBER_FIELD,
        value: historical::PAYLOAD_BLOCK_NUMBER,
        payload_proof: historical::block_number_proof(),
    )
    assert!(value == historical::PAYLOAD_BLOCK_NUMBER)
}

#[test(should_revert)]
fn a_forged_summary_root_does_not_serve_the_cached_path() {
    // The cached path's one trusted input, flipped by one bit. Everything else
    // in the call is the genuine mainnet proof.
    let _ = prove_cached_payload_root<Capella, _>(
        hasher: SoftSha256 {},
        summary_root: historical::BLOCK_SUMMARY_ROOT ^ 1,
        target_slot: historical::TARGET_SLOT,
        target_header: historical::target_header(),
        period_branch: historical::historical_proof().period_branch,
        field: PAYLOAD_BLOCK_HASH_FIELD,
        value: historical::PAYLOAD_BLOCK_HASH,
        payload_proof: historical::block_hash_proof(),
    )
}

#[test(should_revert)]
fn an_uncached_period_is_not_a_summary_root() {
    // A `StorageMap` miss reads as zero, so zero must not be a usable
    // commitment. It would fail the branch check anyway; the explicit test is
    // for the error a caller sees, and so that a future refactor cannot make
    // "not cached yet" look like "cached as zero".
    let _ = prove_cached_payload_root<Capella, _>(
        hasher: SoftSha256 {},
        summary_root: 0,
        target_slot: historical::TARGET_SLOT,
        target_header: historical::target_header(),
        period_branch: historical::historical_proof().period_branch,
        field: PAYLOAD_BLOCK_HASH_FIELD,
        value: historical::PAYLOAD_BLOCK_HASH,
        payload_proof: historical::block_hash_proof(),
    )
}

#[test(should_revert)]
fn the_cached_path_still_refuses_a_pre_capella_slot() {
    // Invariant 9 is not something the anchor was enforcing on its behalf.
    let _ = prove_cached_payload_root<Capella, _>(
        hasher: SoftSha256 {},
        summary_root: historical::BLOCK_SUMMARY_ROOT,
        target_slot: 1,
        target_header: historical::target_header(),
        period_branch: historical::historical_proof().period_branch,
        field: PAYLOAD_BLOCK_HASH_FIELD,
        value: historical::PAYLOAD_BLOCK_HASH,
        payload_proof: historical::block_hash_proof(),
    )
}

// --- Invariant 7, on the composed path --------------------------------------

#[test(should_revert)]
fn the_recent_path_refuses_an_electra_layout_for_a_fulu_target() {
    // This is the case nothing else in the library catches, and the reason
    // `dispatch.fe` exists.
    //
    // Electra and Fulu have identical `ExecutionPayload` shapes -- 17 fields,
    // 5 levels -- so every payload gindex is the same and
    // `PayloadProof<Electra>` is the same 9 words as `PayloadProof<Fulu>`.
    // The branch below is the genuine mainnet one, reconstructed under the
    // other layout; the types accept it and the hashes would verify. Only
    // `require_target_layout` rejects it, by deriving the fork from a slot
    // that a hashed header proved.
    //
    // It matters because the value a caller gets back is only meaningful if
    // the layout they named is the block's own. "It happens to hash the same
    // this time" is not a property to rely on across the next payload change.
    let _ = prove_recent_payload_root<Fulu, Electra, _, _>(
        source: FixedAnchor { timestamp: recent::ANCHOR_TIMESTAMP, root: recent::ANCHOR_ROOT },
        hasher: SoftSha256 {},
        anchor_timestamp: recent::ANCHOR_TIMESTAMP,
        anchor_header: recent::anchor_header(),
        fork_proof: recent::fork_version_proof(),
        target_slot: recent::TARGET_SLOT,
        target_header: recent::target_header(),
        proof: recent::recent_proof(),
        field: PAYLOAD_BLOCK_HASH_FIELD,
        value: recent::PAYLOAD_BLOCK_HASH,
        payload_proof: PayloadProof<Electra> { branch: recent::block_hash_proof().branch },
    )
}

#[test]
fn the_same_proof_under_the_right_layout_still_verifies() {
    // The negative control for the test above: identical call, `T = Fulu`.
    // Without this, a revert for some unrelated reason would look like
    // invariant 7 working.
    let value = prove_recent_payload_root<Fulu, Fulu, _, _>(
        source: FixedAnchor { timestamp: recent::ANCHOR_TIMESTAMP, root: recent::ANCHOR_ROOT },
        hasher: SoftSha256 {},
        anchor_timestamp: recent::ANCHOR_TIMESTAMP,
        anchor_header: recent::anchor_header(),
        fork_proof: recent::fork_version_proof(),
        target_slot: recent::TARGET_SLOT,
        target_header: recent::target_header(),
        proof: recent::recent_proof(),
        field: PAYLOAD_BLOCK_HASH_FIELD,
        value: recent::PAYLOAD_BLOCK_HASH,
        payload_proof: PayloadProof<Fulu> { branch: recent::block_hash_proof().branch },
    )
    assert!(value == recent::PAYLOAD_BLOCK_HASH)
}

// --- The fixture matrix: a Fulu anchor, a target in every fork --------------
//
// One anchor state, four target forks, each at its fork's **first slot**.
// Deneb and Electra both activated on an exact period boundary
// (8,626,176 = 8192 x 1053 and 11,649,024 = 8192 x 1422), so each of these is
// simultaneously a fork's first block and a period's first slot -- the two
// edges most likely to be off by one.
//
// What makes them worth having is that `A` and `T` differ by more each time,
// and `T` sizes the payload branch: Capella's is 8 levels, Deneb's and
// Electra's are 9. The compiler derives that from the fork's payload field
// count, so these tests cannot be made to pass by adjusting a number.

use ingot::fixture_historical_deneb as deneb
use ingot::fixture_historical_electra as electra
use ingot::layout::Deneb

#[test]
fn the_historical_path_proves_the_first_deneb_block() {
    let proven = prove_historical_payload_root<Fulu, Deneb, _, _>(
        source: FixedAnchor { timestamp: recent::ANCHOR_TIMESTAMP, root: deneb::ANCHOR_ROOT },
        hasher: SoftSha256 {},
        anchor_timestamp: recent::ANCHOR_TIMESTAMP,
        anchor_header: deneb::anchor_header(),
        fork_proof: recent::fork_version_proof(),
        target_slot: deneb::TARGET_SLOT,
        target_header: deneb::target_header(),
        proof: deneb::historical_proof(),
        field: PAYLOAD_BLOCK_HASH_FIELD,
        value: deneb::PAYLOAD_BLOCK_HASH,
        payload_proof: deneb::block_hash_proof(),
    )
    assert!(proven.value == deneb::PAYLOAD_BLOCK_HASH)
    assert!(proven.summary_index == deneb::SUMMARY_INDEX)
    // 1053 - 758. Derived from the slot by `summary_index`, never supplied.
    assert!(deneb::SUMMARY_INDEX == 295)
}

#[test]
fn the_historical_path_proves_the_first_electra_block() {
    let proven = prove_historical_payload_root<Fulu, Electra, _, _>(
        source: FixedAnchor { timestamp: recent::ANCHOR_TIMESTAMP, root: electra::ANCHOR_ROOT },
        hasher: SoftSha256 {},
        anchor_timestamp: recent::ANCHOR_TIMESTAMP,
        anchor_header: electra::anchor_header(),
        fork_proof: recent::fork_version_proof(),
        target_slot: electra::TARGET_SLOT,
        target_header: electra::target_header(),
        proof: electra::historical_proof(),
        field: PAYLOAD_BLOCK_HASH_FIELD,
        value: electra::PAYLOAD_BLOCK_HASH,
        payload_proof: electra::block_hash_proof(),
    )
    assert!(proven.value == electra::PAYLOAD_BLOCK_HASH)
    assert!(proven.summary_index == electra::SUMMARY_INDEX)
    // 1422 - 758.
    assert!(electra::SUMMARY_INDEX == 664)
}

#[test]
fn a_deneb_block_number_decodes_little_endian() {
    let value = prove_historical_payload_uint64_check()
    assert!(value == deneb::PAYLOAD_BLOCK_NUMBER)
}

fn prove_historical_payload_uint64_check() -> u64 {
    // The first Deneb block's number, through the cached path: the period was
    // proven above, so this is the same leg a verifier takes after a fork.
    prove_cached_payload_uint64<Deneb, _>(
        hasher: SoftSha256 {},
        summary_root: deneb::BLOCK_SUMMARY_ROOT,
        target_slot: deneb::TARGET_SLOT,
        target_header: deneb::target_header(),
        period_branch: deneb::historical_proof().period_branch,
        field: PAYLOAD_BLOCK_NUMBER_FIELD,
        value: deneb::PAYLOAD_BLOCK_NUMBER,
        payload_proof: deneb::block_number_proof(),
    )
}

#[test]
fn every_fixture_shares_one_anchor() {
    // Five fixtures, one anchor state. The historical tests above hand
    // `recent::fork_version_proof()` to headers from the other fixtures, which
    // is only sound because the anchor really is the same -- so it is pinned
    // here rather than assumed.
    assert!(recent::ANCHOR_ROOT == historical::ANCHOR_ROOT)
    assert!(recent::ANCHOR_ROOT == deneb::ANCHOR_ROOT)
    assert!(recent::ANCHOR_ROOT == electra::ANCHOR_ROOT)
    assert!(recent::ANCHOR_ROOT == missed::ANCHOR_ROOT)
    assert!(deneb::ANCHOR_STATE_ROOT == electra::ANCHOR_STATE_ROOT)
}

#[test(should_revert)]
fn a_deneb_target_cannot_be_read_with_electra_positions() {
    // Invariant 7 across two forks whose payloads are *not* the same shape is
    // caught by the types (that is `compile_fail/wrong_proof_length`). Deneb
    // and Electra have identical payload shapes, so this one compiles and only
    // `require_target_layout` rejects it -- the same hole `dispatch.fe` was
    // written for, now exercised on a historical target.
    let _ = prove_historical_payload_root<Fulu, Electra, _, _>(
        source: FixedAnchor { timestamp: recent::ANCHOR_TIMESTAMP, root: deneb::ANCHOR_ROOT },
        hasher: SoftSha256 {},
        anchor_timestamp: recent::ANCHOR_TIMESTAMP,
        anchor_header: deneb::anchor_header(),
        fork_proof: recent::fork_version_proof(),
        target_slot: deneb::TARGET_SLOT,
        target_header: deneb::target_header(),
        proof: deneb::historical_proof(),
        field: PAYLOAD_BLOCK_HASH_FIELD,
        value: deneb::PAYLOAD_BLOCK_HASH,
        payload_proof: PayloadProof<Electra> { branch: deneb::block_hash_proof().branch },
    )
}
