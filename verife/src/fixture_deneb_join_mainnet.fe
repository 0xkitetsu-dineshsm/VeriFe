/// Binance 14 (0x28C6c06298d514Db089934071355E5743bf21d60), an ERC-20 balance in a mapping.
///
/// keccak256(abi.encode(holder, 9)) -- USDC keeps balances in the mapping at slot 9
///
/// `eth_call balanceOf` at this block returned 0x000000000000000000000000000000000000000000000000000270636fbf0b9c; the
/// storage proof below carries the same number. The call runs the contract's
/// code and never touches the trie; the proof walks the trie and never runs
/// the code.
#[cfg(target = "native")]
pub const HOLDER: u256 = 0x28C6c06298d514Db089934071355E5743bf21d60
/// The storage **slot**, keccak256(abi.encode(holder, 9)). The trie **key**
/// is keccak256 of this again -- see `SLOT_1_KEY`. Naming them apart matters:
/// using one where the other belongs fails with "a node does not hash to the
/// reference that led to it", which says nothing about the real mistake.
#[cfg(target = "native")]
pub const HOLDER_SLOT: u256 = 0x07081a045c3dbf2e63b62a407ef205e7586e2629d2e2b95ff093308ca0ff3727
#[cfg(target = "native")]
pub const HOLDER_BALANCE: u256 = 686522332285852
