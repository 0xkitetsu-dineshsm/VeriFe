static_assert(PAYLOAD_BLOCK_HASH_GINDEX == DERIVED_BLOCK_HASH_GINDEX)

const DERIVED_SUMMARY_GINDEX: u64 = summary_block_root_gindex<Fulu>(index: SUMMARY_INDEX)
static_assert(SUMMARY_GINDEX == DERIVED_SUMMARY_GINDEX)

const DERIVED_SUMMARY_LENGTH_GINDEX: u64 = historical_summaries_length_gindex<Fulu>()
static_assert(SUMMARY_LENGTH_GINDEX == DERIVED_SUMMARY_LENGTH_GINDEX)
